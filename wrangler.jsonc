// Cloudflare Workers static site. Build: npm run build → deploy: npx wrangler deploy
{
  "name": "eatlikeboss",
  "compatibility_date": "2026-11-01",
  // Preview links for branches (uploaded by .github/workflows/check.yml); production is unaffected.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
