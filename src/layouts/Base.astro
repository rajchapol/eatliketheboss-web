---
// Every page uses this layout: <head> SEO, shared header and footer.
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Effects from '../components/Effects.astro';
import MiniBar from '../components/MiniBar.astro';
import { SITE, HREFLANG, DEFAULT_LOCALE, type Locale } from '../lib/config';
import { getSettings } from '../lib/content';
import { t } from '../lib/i18n';

interface Props {
  title: string; // page title without the site name
  description?: string;
  image?: string; // absolute or site-relative share image
  lang?: Locale;
  alternates?: { lang: Locale; href: string }[]; // same page in other languages (incl. this one)
  jsonLd?: object[];
  active?: 'finder' | 'destinations' | 'articles' | 'awards' | 'about' | 'home';
  series?: string; // highlights that series in the Notes menu
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: string; // ISO date → article:published_time
  modified?: string; // ISO date → article:modified_time
  lineart?: boolean;
  dark?: boolean;
}
const { title, description = SITE.description, image = '/img/og-default.jpg', lang = DEFAULT_LOCALE,
  jsonLd = [], active, type = 'website', noindex = false, lineart = true, dark = false, published, modified, series } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const alternates = Astro.props.alternates ?? [{ lang, href: path }];
// The site name is added here, so a title that already ends with it (old Meta titles: "… | บอสพาชิม") is trimmed first.
const bareTitle = title.replace(/\s*[|·—–-]\s*(บอสพาชิม|Eat Like The Boss)\s*$/i, '').trim();
const fullTitle = path === '/' ? `${SITE.name} — รีวิว Fine Dining แบบจริงใจ` : `${bareTitle} — ${t(lang, 'titleSuffix')}`;
// Share image is always 1200×630: article covers are cropped in imgUrl(); the Sanity share image is cropped here.
const settingsOg = (await getSettings()).ogImageUrl;
const cfToken = ((await getSettings()).cfAnalyticsToken || '').trim();
// Google Search Console: the HTML-tag code (content="…"), or the whole <meta> tag pasted in Studio.
const gscRaw = String((await getSettings()).googleSiteVerification || '').trim();
const gsc = (gscRaw.match(/content=["']([^"']+)/)?.[1] || gscRaw).replace(/[^\w-]/g, '');
const ogImage = new URL(image === '/img/og-default.jpg' && settingsOg ? `${settingsOg}?w=1200&h=630&fit=crop&auto=format` : image, SITE.url).href;
// Keep meta descriptions within ~155 characters (cut at a space when possible).
const metaDescription = description.length <= 158 ? description : (() => { const cut = description.slice(0, 152); const sp = cut.lastIndexOf(' '); return (sp > 100 ? cut.slice(0, sp) : cut).trim() + '…'; })();
---
<!doctype html>
<html lang={HREFLANG[lang]}>
<head>
  <meta charset="utf-8" />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('fx-on');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="max-image-preview:large, noai, noimageai" />}
  {gsc && <meta name="google-site-verification" content={gsc} />}
  <meta name="copyright" content="© Eat Like The Boss (บอสพาชิม). All rights reserved." />
  {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={HREFLANG[a.lang]} href={new URL(a.href, SITE.url).href} />)}
  {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL((alternates.find((a) => a.lang === DEFAULT_LOCALE) ?? alternates[0]).href, SITE.url).href} />}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  {published && <meta property="article:published_time" content={published} />}
  {(modified || published) && <meta property="article:modified_time" content={modified || published} />}
  {type === 'article' && <meta property="article:author" content={new URL('/about/', SITE.url).href} />}
  <meta property="og:locale" content={lang === 'th' ? 'th_TH' : lang === 'ja' ? 'ja_JP' : lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0b5357" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href="/fonts/ekkamai-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/noto-serif-thai-thai-400.woff2" as="font" type="font/woff2" crossorigin />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  {/^[a-f0-9]{32}$/i.test(cfToken) && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
</head>
<body>
  <div class={`elb-page ${dark ? 'on-dark' : ''}`} style={dark ? 'background:#073b3e;color:#fff' : undefined}>
    <SiteHeader active={active} lang={lang} alternates={alternates} series={series} />
    <slot />
    <SiteFooter lineart={lineart} lang={lang} />
  </div>
  <MiniBar active={active} lang={lang} series={series} />
  {type === 'article' && <div class="read-progress" aria-hidden="true"><span data-progress></span></div>}
  <Effects lang={lang} />
  <a href="#top" class="to-top" data-to-top aria-label={t(lang, 'toTop')} hidden><svg class="ico" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg></a>
  <script>
    (() => { const b = document.querySelector('[data-to-top]'); if (!b) return;
      const upd = () => { b.hidden = scrollY < innerHeight * 1.5; };
      addEventListener('scroll', upd, { passive: true }); upd();
      b.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); document.querySelector('.site-header a')?.focus({ preventScroll: true }); }); })();
  </script>
</body>
</html>
