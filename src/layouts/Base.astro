---
// Every page uses this layout: <head> SEO, shared header and footer.
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, HREFLANG, DEFAULT_LOCALE, type Locale } from '../lib/config';

interface Props {
  title: string; // page title without the site name
  description?: string;
  image?: string; // absolute or site-relative share image
  lang?: Locale;
  alternates?: { lang: Locale; href: string }[]; // same page in other languages (incl. this one)
  jsonLd?: object[];
  active?: 'finder' | 'destinations' | 'articles' | 'awards' | 'about' | 'home';
  type?: 'website' | 'article';
  noindex?: boolean;
  lineart?: boolean;
  dark?: boolean;
}
const { title, description = SITE.description, image = '/img/og-default.jpg', lang = DEFAULT_LOCALE,
  jsonLd = [], active, type = 'website', noindex = false, lineart = true, dark = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const alternates = Astro.props.alternates ?? [{ lang, href: path }];
const fullTitle = path === '/' ? `${SITE.name} — รีวิว Fine Dining แบบจริงใจ` : `${title} — บอสพาชิม`;
const ogImage = new URL(image, SITE.url).href;
---
<!doctype html>
<html lang={HREFLANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={HREFLANG[a.lang]} href={new URL(a.href, SITE.url).href} />)}
  {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL((alternates.find((a) => a.lang === DEFAULT_LOCALE) ?? alternates[0]).href, SITE.url).href} />}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'th' ? 'th_TH' : lang === 'ja' ? 'ja_JP' : lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0b5357" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href="/fonts/ekkamai-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Noto+Serif+Thai:wght@300;400;600&display=swap" />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <div class={`elb-page ${dark ? 'on-dark' : ''}`} style={dark ? 'background:#073b3e;color:#fff' : undefined}>
    <SiteHeader active={active} lang={lang} alternates={alternates} />
    <slot />
    <SiteFooter lineart={lineart} />
  </div>
</body>
</html>
