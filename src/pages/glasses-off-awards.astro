---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { getArticles, glassesOffDishes, getSettings, dishUrl, visitYear } from '../lib/content';
const st = await getSettings();
import { SITE } from '../lib/config';
import { romanAt as roman } from '../lib/roman';
import sealSvg from '../../public/img/brand/award-seal-2026.svg?raw';

const articles = await getArticles('th');
const items = glassesOffDishes(articles);
const years = [...new Set(items.map((x) => visitYear(x.article)))].sort().reverse(); // by the year of the meal
// Seal shows the latest awards year (the file's 2026 is replaced), inline so it uses the site's fonts.
const sealYear = years[0] ?? String(new Date().getFullYear());
const seal = sealSvg.replace(/<\?xml[^>]*>/, '').replace('>2026<', `>${sealYear}<`)
  .replace(/id="([^"]+)"/g, 'id="seal-$1"').replace(/url\(#([^)]+)\)/g, 'url(#seal-$1)'); // unique ids on the page
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Glasses Off Awards',
  itemListElement: items.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.dish.name, url: new URL(dishUrl(x.article, x.index), SITE.url).href })),
};

// The glasses: each lens is a honeycomb of hexagon dish photos, clipped to the lens and drifting slowly
// (and following the mouse) like a view through real lenses. Glasses-off dishes come first (gold rim);
// remaining cells are filled with the Boss's other dishes.
const W = 1000, H = 385, R = 197, LENSES = [270, 730]; // frame geometry in viewBox units
const TW = 21, TH = TW * 1.1547, ROW = TH * 0.75;   // hex cell size, % of the lens grid (grid = lens + 8% margin each side)
const cells: { x: number; y: number }[] = [];
for (let r = 0, y = -TH / 2; y < 100 + TH / 2; r++, y += ROW)
  for (let x = (r % 2 ? TW / 2 : 0) - TW / 2; x < 100 + TW / 2; x += TW)
    if (Math.hypot(x + TW / 2 - 50, y + TH / 2 - 50) < 50 / 1.16 + TW * 0.45) cells.push({ x, y }); // keep cells that show inside the lens
const pool = [
  ...items.filter((x) => x.dish.image).map((x) => ({ ...x, gold: true })),
  ...articles.flatMap((a) => a.dishes.map((dish, index) => ({ dish, article: a, index, gold: false }))).filter((x) => x.dish.image && !x.dish.glassesOff),
];
// With fewer photos than cells, photos repeat; the repeats are decoration only (hidden from keyboard and screen readers).
let n = 0;
const lenses = pool.length ? LENSES.map((cx) => ({ cx, cells: cells.map((c) => { const t = pool[n % pool.length]; const repeat = n >= pool.length; n++; return { ...c, ...t, repeat }; }) })) : [];
---
<Base title="Glasses Off Awards — จานที่อร่อยจนบอสต้องถอดแว่นชิม" description="รวมทุกจานที่อร่อยจนบอสต้องขอถอดแว่นชิม คัดจากบันทึกการชิมทั้งปี ไม่ผูกกับดาวของร้าน" active="awards" dark jsonLd={[ld]}>
  <section aria-labelledby="aw" class="spot" style="background:radial-gradient(ellipse at 50% 0%,#0f6b6a 0%,#0b5357 40%,#073b3e 100%)">
    <div class="wrap" style="max-width:900px;padding-top:80px;padding-bottom:40px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
      <span role="img" aria-label={`ตรา Glasses Off Awards ${sealYear}`} class="gold-glow seal" set:html={seal} />
      <h1 id="aw" style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(48px,9cqi,80px);line-height:1">Glasses Off <span class="fx-shimmer gold-glow" style="font-style:italic">Awards</span></h1>
      <p style="margin:8px 0 0;max-width:34em;font-size:18px;line-height:1.85;font-weight:400;color:#fff">{st.awardsIntro}</p>
      {years.length > 1 && <nav aria-label="เลือกปี" style="display:flex;gap:8px;margin-top:16px;font-family:'Ekkamai New',sans-serif;font-size:15px">{years.map((y) => <a href={`#y${y}`} class="chip" style="padding:8px 22px;box-shadow:0 0 0 1px rgba(212,179,114,.6)">{y}</a>)}</nav>}
    </div>
    {lenses.length > 0 && (
      <div class="wrap" style="padding-bottom:88px">
        <div class="specs" role="group" aria-label="จานถอดแว่นชิม เรียงเป็นแว่นของบอส">
          <svg class="specs-frame" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <defs><linearGradient id="rim" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fdeac0" /><stop offset=".5" stop-color="#d4b372" /><stop offset="1" stop-color="#926633" /></linearGradient></defs>
            <circle cx="270" cy={H / 2} r="197" fill="rgba(253,234,192,.04)" stroke="url(#rim)" stroke-width="5" />
            <circle cx="730" cy={H / 2} r="197" fill="rgba(253,234,192,.04)" stroke="url(#rim)" stroke-width="5" />
            <path d={`M455 ${H / 2 - 40} Q500 ${H / 2 - 82} 545 ${H / 2 - 40}`} fill="none" stroke="url(#rim)" stroke-width="6" stroke-linecap="round" />
            <path d={`M82 ${H / 2 - 50} L8 ${H / 2 - 92}`} fill="none" stroke="url(#rim)" stroke-width="6" stroke-linecap="round" />
            <path d={`M918 ${H / 2 - 50} L992 ${H / 2 - 92}`} fill="none" stroke="url(#rim)" stroke-width="6" stroke-linecap="round" />
          </svg>
          {lenses.map((l, li) => (
            <div class="lens" style={`left:${((l.cx - R) / W) * 100}%;top:${((H / 2 - R) / H) * 100}%;width:${(2 * R / W) * 100}%;height:${(2 * R / H) * 100}%`}>
              <div class="lens-grid" style={`animation-delay:${li * -7}s`}>
                {l.cells.map((t) => (
                  <a href={dishUrl(t.article, t.index)} class={t.gold ? 'cell gold' : 'cell'} data-name={t.dish.name} data-place={t.article.restaurant?.name ?? t.article.title}
                    aria-hidden={t.repeat ? 'true' : undefined} tabindex={t.repeat ? -1 : undefined} aria-label={t.repeat ? undefined : `${t.dish.name} — ${t.article.restaurant?.name ?? t.article.title}`}
                    style={`left:${t.x}%;top:${t.y}%;width:${TW}%;height:${TH}%`}>
                    <span class="hx"><span class="hx-in"><Photo img={t.dish.image} label={t.dish.name} ratio={1} widths={[200, 360]} sizes="(max-width: 720px) 90px, 180px" /></span></span>
                  </a>
                ))}
              </div>
            </div>
          ))}
          <svg class="specs-tint" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <defs>
              <radialGradient id="lensTint" cx="36%" cy="28%" r="78%"><stop offset="0" stop-color="#1d4245" stop-opacity=".84" /><stop offset=".55" stop-color="#071a1c" stop-opacity=".93" /><stop offset="1" stop-color="#010708" stop-opacity=".97" /></radialGradient>
              <linearGradient id="glare" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".26" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
              <clipPath id="lenses"><circle cx="270" cy={H / 2} r="197" /><circle cx="730" cy={H / 2} r="197" /></clipPath>
            </defs>
            <g class="tint-dark"><circle cx="270" cy={H / 2} r="197" fill="url(#lensTint)" /><circle cx="730" cy={H / 2} r="197" fill="url(#lensTint)" /></g>
            <g clip-path="url(#lenses)"><rect class="glare" x="40" y="-60" width="150" height={H + 120} fill="url(#glare)" transform="rotate(24 500 192)" /></g>
          </svg>
        </div>
        <p class="specs-now" data-specs-now aria-live="polite"><span class="hint-hover">ชี้ที่รูปเพื่อดูชื่อจาน · กดเพื่อไปที่จาน</span><a class="hint-touch" href={`#y${years[0] ?? ""}`} style="color:#fdeac0;border-bottom:1px solid #d4b372;padding:10px 0">ดูทุกจานด้านล่าง</a> · <span style="color:#fdeac0">ขอบทอง = จานถอดแว่นชิม</span></p>
      </div>
    )}
  </section>
  <main class="wrap" style="padding-bottom:96px">
    {years.map((y) => (
      <section id={`y${y}`} aria-label={`Glasses Off Awards ${y}`} style="padding-top:64px;scroll-margin-top:24px">
        <h2 class="gold-grad" style="margin:0 0 24px;font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:52px;line-height:1.1">{y}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:28px">
          {items.filter((x) => visitYear(x.article) === y).map((x, i) => (
            <a href={dishUrl(x.article, x.index)} class="fx-lift rc" style="display:flex;flex-direction:column;background:rgba(11,83,87,.6);box-shadow:0 0 0 1px rgba(212,179,114,.5),0 16px 36px rgba(0,0,0,.25)">
              <span class="fx-zoom" style="position:relative;display:block;aspect-ratio:3/2"><Photo img={x.dish.image ?? x.article.cover} label="ภาพจาน" dark ratio={0.6667} widths={[400, 600, 900]} sizes="(max-width: 720px) 100vw, 380px" />
                <span style="position:absolute;left:16px;bottom:10px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:44px;line-height:1;color:#fdeac0;text-shadow:0 2px 14px rgba(0,0,0,.55)">{roman(i)}.</span>
                {x.article.city && <span class="badge badge-dark" style="position:absolute;right:12px;top:12px">{x.article.city.nameEn}</span>}</span>
              <span style="display:flex;flex-direction:column;gap:6px;padding:18px 20px 22px">
                <span style="font-size:21px;font-weight:600;line-height:1.45;color:#fff">{x.dish.name}</span>
                <span style="font-family:'Ekkamai New',sans-serif;font-size:15px;color:rgba(255,255,255,.92)">{x.article.restaurant?.name ?? x.article.title} · Tasting Notes No. {String(x.article.no).padStart(3, '0')}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
    {items.length === 0 && <p style="padding-top:56px;text-align:center">ยังไม่มีจานถอดแว่นชิมครับ</p>}
  </main>
  <script>
    // Sunglasses: the lenses start dark and clear ("glasses off") once the glasses are well in view.
    (() => { const s = document.querySelector('.specs'); if (!s) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      s.classList.add('shade');
      const io = new IntersectionObserver(([e]) => { if (e.intersectionRatio >= 0.6) { io.disconnect(); setTimeout(() => s.classList.add('lit'), 900); } }, { threshold: [0, 0.6, 1] });
      io.observe(s); })();
    // Through the lens: photos shift against the mouse; the dish name shows under the glasses.
    (() => { const s = document.querySelector('.specs'), now = document.querySelector('[data-specs-now]'); if (!s || !now) return;
      const hint = now.innerHTML, fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (fine && !matchMedia('(prefers-reduced-motion: reduce)').matches) s.addEventListener('pointermove', (e) => {
        const r = s.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        s.style.setProperty('--tx', (-x * 26).toFixed(1) + 'px'); s.style.setProperty('--ty', (-y * 26).toFixed(1) + 'px');
      });
      const show = (c) => { now.textContent = ''; const b = document.createElement('strong'); b.textContent = c.dataset.name; const sm = document.createElement('span'); sm.textContent = '  ·  ' + c.dataset.place; if (c.classList.contains('gold')) { const g = document.createElement('em'); g.textContent = 'GLASSES OFF  '; now.append(g); } now.append(b, sm); };
      s.querySelectorAll('.cell').forEach((c) => { c.addEventListener('pointerenter', () => show(c)); c.addEventListener('focus', () => show(c)); });
      s.addEventListener('pointerleave', () => (now.innerHTML = hint)); })();
  </script>
</Base>
