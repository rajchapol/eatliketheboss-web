---
import { isRestaurantSeries } from '../lib/config';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { SITE, SERIES } from '../lib/config';
import HeroSlider from '../components/HeroSlider.astro';
import { getArticles, getCities, articleUrl, glassesOffDishes, getSettings, groupByRestaurant, dishUrl, visitIso, visitLabel, visitYear, citiesByCount, restaurantKey, numLabel } from '../lib/content';
import { organization, website } from '../lib/seo';
import { romanAt as roman } from '../lib/roman';

const articles = await getArticles('th');
const settings = await getSettings();
// Slider: the 5 latest restaurants visited (one slide per restaurant). A featured article set in Sanity goes first.
const featured = articles.find((a) => a.id === settings.featuredArticleId || a.baseId === settings.featuredArticleId);
const latest = groupByRestaurant(articles.filter((a) => isRestaurantSeries(a.series))).map((g) => g.latest);
const slides = (featured ? [featured, ...latest.filter((a) => restaurantKey(a) !== restaurantKey(featured))] : latest).slice(0, 5);
// Home shows only the latest reviews (the Boss, 26 Nov 2026: no duplicate of the full list); the full list lives on /review/.
const INDEX_SHOW = 8;
// Reviews only (the Boss, 14 Nov 2026): other series get their own strip below, so 20 episodes posted on one day don't push the reviews off the list.
const reviews = articles.filter((a) => a.series === 'review'); // newest visit first; No. 001 is the oldest
const index = reviews.slice(0, INDEX_SHOW);
// One strip per other series that has articles: newest episodes first, 4 cards.
const strips = (Object.keys(SERIES) as (keyof typeof SERIES)[]).filter((k) => k !== 'review').map((k) => {
  const all = articles.filter((a) => a.series === k).sort((a, b) => (b.episode ?? 0) - (a.episode ?? 0));
  return { key: k, s: SERIES[k], total: all.length, items: all.slice(0, 4) };
}).filter((x) => x.total > 0);
// Repeat visit marker in The Index: 2 = second time at this restaurant (counted by visit order).
const returnNo = (a: (typeof articles)[number]) => { const vs = articles.filter((x) => restaurantKey(x) === restaurantKey(a)); return vs.length - vs.indexOf(a); };
// Glasses Off band: this year's dishes (by visit); before the first one of the year, the latest year that has any.
const allAwards = glassesOffDishes(articles);
const thisYear = String(new Date().getFullYear());
const year = allAwards.some((x) => visitYear(x.article) === thisYear) ? thisYear : (allAwards.map((x) => visitYear(x.article)).sort().pop() ?? thisYear);
const awards = allAwards.filter((x) => visitYear(x.article) === year).slice(0, 4);
const allCities = await getCities();
// "In this issue" contents (the Boss, 16 Nov 2026: magazine style): numbered like a contents page, each links to its section.
const toc = [
  // Every series section is named by its series (the Boss, 25 Nov 2026): The Boss Dines · บอสพาชิม, like the strips below.
  { no: '01', en: SERIES.review.en, th: SERIES.review.th, meta: `${reviews.length} รีวิว`, href: '#notes', icon: 'index' },
  ...strips.map((x) => ({ no: '', en: x.s.en, th: x.s.th, meta: `${x.total} ตอน`, href: `#strip-${x.key}`, icon: x.key === 'drinks' ? 'drinks' : 'history' })),
  { no: '', en: 'Glasses Off Awards', th: 'จานถอดแว่นชิม', meta: `${allAwards.length} จาน`, href: '#awards', icon: 'glasses' },
  { no: '', en: 'Destinations', th: 'จุดหมาย', meta: `${allCities.length} เมือง`, href: '/destinations/', icon: 'destinations' },
  { no: '', en: 'The Boss', th: 'เกี่ยวกับบอส', meta: 'F&B มากว่า 15 ปี', href: '#about', icon: 'the-boss' },
].map((x, i) => ({ ...x, no: String(i + 1).padStart(2, '0') }));
const tocNo = (href: string) => toc.find((x) => x.href === href)?.no;
// Thai titles break only between these chunks (Chrome split "มื้ออาหารเปลี่ยน / โลก")
const TOC_CHUNKS: Record<string, string[]> = { 'มื้ออาหารเปลี่ยนโลก': ['มื้ออาหาร', 'เปลี่ยนโลก'], 'จานถอดแว่นชิม': ['จานถอดแว่นชิม'], 'บันทึกการชิม': ['บันทึกการชิม'], 'เกี่ยวกับบอส': ['เกี่ยวกับบอส'], 'บอสพาดื่ม': ['บอสพาดื่ม'] };
---
<Base title="หน้าแรก" active="home" jsonLd={[organization(), website()]}>
  <h1 class="sr-only">บอสพาชิม Eat Like The Boss — รีวิวร้านอาหาร Fine Dining แบบจริงใจและเจาะลึก ทั้งในไทยและทั่วโลก</h1>

  <section aria-label="ค้นหาร้าน" class="pat-linen" style="background-color:#fbf7ef;box-shadow:0 10px 24px rgba(195,158,92,.18)">
    <form action="/restaurants/" method="get" class="wrap" style="padding-top:20px;padding-bottom:20px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;font-family:'Ekkamai New',sans-serif">
      <span style="flex:1 1 320px;position:relative;display:block">
        <Icon name="search" style="position:absolute;left:18px;top:14px;color:#0b5357" />
        <input id="q" name="q" type="search" aria-label={settings.homeFinderLabel} class="field" placeholder={settings.homeSearchPlaceholder} style="width:100%;height:48px;padding:0 56px 0 48px;border:1px solid rgba(11,83,87,.4);background:#fff;font:inherit;font-size:16px;color:#1a2632" />
        <button type="submit" class="search-go" aria-label="ค้นหา"><Icon name="arrow" size={18} /></button>
      </span>
    </form>
  </section>

  <HeroSlider slides={slides} />

  <nav aria-labelledby="toc-h" class="wrap toc" style="padding-bottom:96px">
    <div class="toc-head"><span id="toc-h" lang="en" translate="no">In This Issue</span><span class="toc-th">ในฉบับนี้</span></div>
    <ol class="toc-list">
      {toc.map((x) => (
        <li><a href={x.href} class="toc-item">
          <span class="outline-num toc-no" aria-hidden="true" translate="no">{x.no}</span>
          <span class="toc-en" lang="en" translate="no"><Icon name={x.icon as any} size={22} class="toc-ico" />{x.en}</span>
          <span class="toc-title">{(TOC_CHUNKS[x.th] ?? [x.th]).map((c) => <span class="nb">{c}</span>)}</span>
          <span class="toc-meta">{x.meta}</span>
        </a></li>
      ))}
    </ol>
  </nav>


  <section id="notes" aria-labelledby="index" class="wrap" style="padding-bottom:96px">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px 16px;padding-bottom:16px">
      <div style="display:flex;flex-direction:column;gap:6px">
        <span lang="en" translate="no" class="sec-kicker" style={`color:${SERIES.review.ink}`}><span>{tocNo('#notes')}</span>{SERIES.review.en}</span>
        <h2 id="index" style={`margin:0;font-size:clamp(28px,4.4cqi,40px);font-weight:600;line-height:1.3;color:${SERIES.review.ink}`}>{SERIES.review.th}</h2>
      </div>
      <a href="/review/" class="fx-arrow" style="display:inline-flex;align-items:center;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357;border-bottom:1px solid #c39e5c">ดูทั้ง {reviews.length} รีวิว<Icon name="arrow" size={16} /></a>
    </div>
    <div class="rule fx-draw"></div>
    {index.length === 0 && (
      <div style="padding:48px 0;display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center">
        <img src="/img/brand/empty-state-cloche.svg" alt="" width="220" height="138" style="height:auto" />
        <p style="margin:0;font-size:18px;font-weight:400">บันทึกการชิมฉบับแรกกำลังจะเสิร์ฟเร็วๆ นี้ครับ</p>
        <a href={SITE.facebook} rel="me" class="fx-under" style="font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357;border-bottom:1px solid #c39e5c">ติดตามบอสพาชิมบน Facebook ระหว่างรอ</a>
      </div>
    )}
    {index.map((a, i) => (
      <a href={articleUrl(a)} class="idx-row fx-row">
        <span class="idx-no" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:24px;color:#6e3f08">{numLabel(a)}</span>
        <span class="idx-thumb"><Photo img={a.cover} label="ภาพ" ratio={0.6667} widths={[192, 288]} sizes="96px" /></span>
        <span class="idx-title" style="min-width:0;display:flex;flex-direction:column;gap:2px"><span style="font-size:19px;font-weight:600;line-height:1.4">{a.series === 'review' ? (a.restaurant?.name ?? a.title) : a.title}{a.series === 'review' && returnNo(a) > 1 && <span class="band-pill" style="margin-left:8px;padding:1px 10px;font-family:'Ekkamai New',sans-serif;font-size:12px;font-weight:400;vertical-align:3px;box-shadow:0 0 0 1px rgba(195,158,92,.6);color:#6e3f08">กลับไปครั้งที่ {returnNo(a)}</span>}</span>{a.series === 'review' && <span style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955">{[a.city?.nameEn, a.tagline].filter(Boolean).join(' · ')}</span>}</span>
        <span class="idx-date" style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955;text-align:right"><span class="sr-only">ไปเยือน </span><time datetime={visitIso(a)}>{visitLabel(a)}</time></span>
      </a>
    ))}
  </section>

  {strips.map(({ key, s, total, items }) => (
    <section aria-labelledby={`strip-${key}`} class="wrap series-strip" style={`--sdot:${s.dot};--sink:${s.ink};padding-bottom:96px`}>
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px 16px;padding-bottom:16px">
        <div style="display:flex;flex-direction:column;gap:6px">
          <span lang="en" translate="no" class="sec-kicker" style="color:var(--sink)"><span>{tocNo(`#strip-${key}`)}</span>{s.en}</span>
          <h2 id={`strip-${key}`} style="margin:0;font-size:clamp(28px,4.4cqi,40px);font-weight:600;line-height:1.3;color:var(--sink)">{s.th}</h2>
        </div>
        <a href={`/${s.path}/`} class="fx-arrow" style="display:inline-flex;align-items:center;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357;border-bottom:1px solid #c39e5c">ดูทั้ง {total} ตอน<Icon name="arrow" size={16} /></a>
      </div>
      <div class="rule fx-draw" style="background:linear-gradient(90deg,var(--sink),rgba(195,158,92,.4))"></div>
      <div class="strip-row">
        {items.map((a) => (
          <a href={articleUrl(a)} class="strip-card fx-row">
            <span class="strip-photo"><Photo img={a.cover} label="ภาพ" ratio={0.6667} widths={[360, 540, 720]} sizes="(max-width: 720px) 72vw, 280px" /></span>
            <span class="strip-ep" translate="no">Ep.{a.episode}</span>
            <span class="strip-title">{a.title}</span>
          </a>
        ))}
      </div>
    </section>
  ))}


  <section id="awards" aria-labelledby="aw" class="band-fan on-dark spot" style="color:#fff">
    <div class="goldrule"></div>
    <div class="wrap sm-tight" style="padding-top:96px;padding-bottom:96px;display:flex;flex-direction:column;gap:48px">
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px">
        <p class="sec-kicker on-dark-k" aria-hidden="true" translate="no" style="flex-basis:100%"><span>{tocNo('#awards')}</span>Glasses Off Awards</p>
        <div style="display:flex;align-items:center;gap:20px"><Icon name="glasses" size={56} class="gold-glow" style="color:#d4b372;stroke-width:1.2" />
          <div><h2 id="aw" style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(34px,5cqi,44px);line-height:1">Glasses Off <span class="fx-shimmer gold-glow" style="font-style:italic">Awards</span> {year}</h2><p style="margin:10px 0 0;font-size:18px;font-weight:500;letter-spacing:.02em;color:#fdeac0">จานถอดแว่นชิมแห่งปี</p></div></div>
        <p style="margin:0;max-width:26em;font-size:17px;line-height:1.8;font-weight:400">{settings.homeAwardsText}</p>
      </div>
      <ol class="aw-row" style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px">
        {awards.map(({ dish, article, index: di }, i) => (
          <li class="fx-lift rc aw-card">
            <a href={dishUrl(article, di)} style="display:flex;flex-direction:column;height:100%">
              <span class="fx-zoom aw-photo"><Photo img={dish.image ?? article.cover} label="ภาพจาน" dark ratio={1.25} widths={[400, 600]} sizes="(max-width: 720px) 100vw, 300px" />
                <img src="/img/brand/go-mark.svg" alt="" width="40" height="40" class="go-mark" style="position:absolute;left:12px;top:12px" />
                <span class="gold-glow aw-roman">{roman(i)}.</span></span>
              <span class="aw-cap">
                <strong style="font-size:19px;font-weight:600;line-height:1.45">{dish.name}</strong>
                <span style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:rgba(255,255,255,.92)">{[article.restaurant?.name ?? article.title, article.city?.nameEn].filter(Boolean).join(' · ')}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <a href="/glasses-off-awards/" class="btn-gold fx-btn" style="align-self:flex-start">ดูจานถอดแว่นชิมทั้งหมด · Glasses Off Awards <Icon name="arrow" /></a>
    </div>
  </section>

  <section id="about" aria-labelledby="ab" class="wrap" style="display:flex;flex-wrap:wrap;gap:32px 48px;padding-top:96px;padding-bottom:96px;align-items:center">
    <div style="flex:0 0 200px;width:200px;height:200px;border-radius:50%;background:#fbf7ef;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 1px rgba(212,179,114,.6),0 18px 40px rgba(195,158,92,.3)">
      <img src="/img/monogram.webp" alt="ELB monogram" width="160" height="160" loading="lazy" style="width:160px;height:auto" />
    </div>
    <div style="flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:16px">
      <p class="sec-kicker" aria-hidden="true" translate="no"><span>{tocNo('#about')}</span>The Boss</p>
      <h2 id="ab" style="margin:0;font-size:32px;font-weight:600;line-height:1.3"><a href="/about/">เกี่ยวกับบอส</a></h2>
      {SITE.tagline && <p class="gold-grad" style="margin:0;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;line-height:1.4">{SITE.tagline}</p>}
      <p style="margin:0;max-width:36em;font-size:17px;line-height:1.85;font-weight:400">{settings.aboutShortBio}</p>
      <p style="margin:0;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#4a5560">{settings.invitedNote}</p>
    </div>
  </section>
</Base>

