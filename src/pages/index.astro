---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { SITE, SERIES } from '../lib/config';
import HeroSlider from '../components/HeroSlider.astro';
import { getArticles, getCities, articleUrl, glassesOffDishes, getSettings, groupByRestaurant, dishUrl, visitIso, visitLabel, visitYear, citiesByCount, restaurantKey } from '../lib/content';
import { organization, website } from '../lib/seo';
import { romanAt as roman } from '../lib/roman';

const articles = await getArticles('th');
const settings = await getSettings();
// Slider: the 5 latest restaurants visited (one slide per restaurant). A featured article set in Sanity goes first.
const featured = articles.find((a) => a.id === settings.featuredArticleId || a.baseId === settings.featuredArticleId);
const latest = groupByRestaurant(articles.filter((a) => a.series === 'review')).map((g) => g.latest);
const slides = (featured ? [featured, ...latest.filter((a) => restaurantKey(a) !== restaurantKey(featured))] : latest).slice(0, 5);
const index = articles.slice(0, 10);
// Glasses Off band: this year's dishes (by visit); before the first one of the year, the latest year that has any.
const allAwards = glassesOffDishes(articles);
const thisYear = String(new Date().getFullYear());
const year = allAwards.some((x) => visitYear(x.article) === thisYear) ? thisYear : (allAwards.map((x) => visitYear(x.article)).sort().pop() ?? thisYear);
const awards = allAwards.filter((x) => visitYear(x.article) === year).slice(0, 4);
const allCities = await getCities();
// Quick city buttons: chosen in Sanity, else the 3 cities with the most restaurants.
const quickCities = settings.homeCitySlugs?.length
  ? (settings.homeCitySlugs.map((sl) => allCities.find((c) => c.slug === sl)).filter(Boolean) as typeof allCities)
  : (await citiesByCount()).slice(0, 3).map((x) => x.city);
---
<Base title="หน้าแรก" active="articles" jsonLd={[organization(), website()]}>
  <h1 class="sr-only">บอสพาชิม Eat Like The Boss — รีวิวร้านอาหาร Fine Dining แบบจริงใจและเจาะลึก ทั้งในไทยและทั่วโลก</h1>

  <section aria-label="ค้นหาร้าน" class="pat-linen" style="background-color:#fbf7ef;box-shadow:0 10px 24px rgba(195,158,92,.18)">
    <form action="/restaurants/" method="get" class="wrap" style="padding-top:20px;padding-bottom:20px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;font-family:'Ekkamai New',sans-serif">
      <label for="q" style="font-size:15px;color:#4a5560">{settings.homeFinderLabel}</label>
      <span style="flex:1 1 320px;position:relative;display:block">
        <Icon name="search" style="position:absolute;left:18px;top:14px;color:#0b5357" />
        <input id="q" name="q" type="search" class="field" placeholder="ชื่อร้าน เชฟ หรือเมือง…" style="width:100%;height:48px;padding:0 56px 0 48px;border:1px solid rgba(11,83,87,.4);background:#fff;font:inherit;font-size:16px;color:#1a2632" />
        <button type="submit" class="search-go" aria-label="ค้นหา"><Icon name="arrow" size={18} /></button>
      </span>
      <span style="display:flex;flex-wrap:wrap;gap:8px;font-size:14px">
        {quickCities.map((c) => <a href={`/city/${c.slug}/`} class="fx-btn chip" style="display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 16px;border:1px solid rgba(11,83,87,.35);background:#fff"><Icon name="pin" size={16} style="color:#0b5357" />{c.nameEn}</a>)}
        <a href="/destinations/" style="display:inline-flex;align-items:center;min-height:40px;padding:0 14px;color:#0b5357">ทุกเมือง</a>
      </span>
    </form>
  </section>

  <HeroSlider slides={slides} />

  <section id="notes" aria-labelledby="index" class="wrap" style="padding-bottom:96px">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding-bottom:16px">
      <h2 id="index" class="ink-grad gold-lift" style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-style:italic;font-size:56px;line-height:1">The Index</h2>
      <a href="/review/" style="font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357;border-bottom:1px solid #c39e5c">บันทึกการชิมทั้งหมด</a>
    </div>
    <div class="rule fx-draw"></div>
    {index.length === 0 && (
      <div style="padding:48px 0;display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center">
        <img src="/img/brand/empty-state-cloche.svg" alt="" width="220" height="138" style="height:auto" />
        <p style="margin:0;font-size:18px;font-weight:400">บันทึกการชิมฉบับแรกกำลังจะเสิร์ฟเร็วๆ นี้ครับ</p>
        <a href={SITE.facebook} rel="me" class="fx-under" style="font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357;border-bottom:1px solid #c39e5c">ติดตามบอสพาชิมบน Facebook ระหว่างรอ</a>
      </div>
    )}
    {index.map((a) => (
      <a href={articleUrl(a)} class="idx-row fx-row">
        <span class="idx-no" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:24px;color:#6e3f08">No. {String(a.no).padStart(3, '0')}</span>
        <span class="idx-thumb"><Photo img={a.cover} label="ภาพ" ratio={0.6667} widths={[192, 288]} sizes="96px" /></span>
        <span class="idx-title" style="min-width:0;display:flex;flex-direction:column;gap:2px"><span style="font-size:19px;font-weight:600;line-height:1.4">{a.series === 'review' ? (a.restaurant?.name ?? a.title) : a.title}</span>{a.series === 'review' && <span style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955">{[a.city?.nameEn, a.tagline].filter(Boolean).join(' · ')}</span>}</span>
        <span class="idx-series" style="display:inline-flex;align-items:center;gap:10px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955"><span aria-hidden="true" style={`width:8px;height:8px;border-radius:50%;background:${SERIES[a.series].dot}`}></span>{SERIES[a.series].th}</span>
        <span class="idx-date" style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955;text-align:right"><span class="sr-only">ไปเยือน </span><time datetime={visitIso(a)}>{visitLabel(a)}</time></span>
      </a>
    ))}
  </section>

  <section aria-label="สโลแกน" class="wrap" style="padding-bottom:104px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center">
    <div class="divider" aria-hidden="true" style="margin-bottom:24px;width:100%"><span></span><svg viewBox="0 0 40 16" width="40" height="16"><path d="M20 1l7 7-7 7-7-7z" fill="none" stroke="#c39e5c" stroke-width="1.2"/><circle cx="20" cy="8" r="2" fill="#c39e5c"/><path d="M2 8h8M30 8h8" stroke="#c39e5c" stroke-width="1.2"/></svg><span></span></div>
    <span aria-hidden="true" class="gold-grad" style="font-family:'Cormorant Garamond',serif;font-size:128px;line-height:.8">“</span>
    <p style="margin:0;max-width:28em;font-size:clamp(22px,3.4cqi,28px);line-height:1.6;font-weight:400">{SITE.tagline}</p>
  </section>

  <section aria-labelledby="aw" class="band-fan on-dark" style="color:#fff">
    <div class="goldrule"></div>
    <div class="wrap sm-tight" style="padding-top:96px;padding-bottom:96px;display:flex;flex-direction:column;gap:48px">
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px">
        <div style="display:flex;align-items:center;gap:20px"><Icon name="glasses" size={56} class="gold-glow" style="color:#d4b372;stroke-width:1.2" />
          <h2 id="aw" style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(34px,5cqi,44px);line-height:1">Glasses Off <span class="fx-shimmer gold-glow" style="font-style:italic">Awards</span> {year}</h2></div>
        <p style="margin:0;max-width:26em;font-size:17px;line-height:1.8;font-weight:400">{settings.homeAwardsText}</p>
      </div>
      <ol class="aw-row" style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px">
        {awards.map(({ dish, article, index: di }, i) => (
          <li class="fx-lift rc" style="background:rgba(7,59,62,.7);box-shadow:0 0 0 1px rgba(212,179,114,.5),0 16px 36px rgba(0,0,0,.25)">
            <a href={dishUrl(article, di)} style="display:flex;flex-direction:column;height:100%">
              <span class="fx-zoom" style="position:relative;display:block;aspect-ratio:3/2"><Photo img={dish.image ?? article.cover} label="ภาพจาน" dark ratio={0.6667} widths={[400, 600]} sizes="(max-width: 720px) 100vw, 300px" />
                <span class="gold-glow" style="position:absolute;left:16px;bottom:10px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:40px;line-height:1;color:#fdeac0;text-shadow:0 2px 12px rgba(0,0,0,.5)">{roman(i)}.</span></span>
              <span style="display:flex;flex-direction:column;gap:6px;padding:18px 20px 22px">
                <strong style="font-size:19px;font-weight:600;line-height:1.45">{dish.name}</strong>
                <span style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:rgba(255,255,255,.92)">{[article.restaurant?.name ?? article.title, article.city?.nameEn].filter(Boolean).join(' · ')}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <a href="/glasses-off-awards/" class="btn-gold fx-btn" style="align-self:flex-start">ดู Glasses Off Awards ทั้งหมด <Icon name="arrow" /></a>
    </div>
  </section>

  <section id="about" aria-labelledby="ab" class="wrap" style="display:flex;flex-wrap:wrap;gap:32px 48px;padding-top:96px;padding-bottom:96px;align-items:center">
    <div style="flex:0 0 200px;width:200px;height:200px;border-radius:50%;background:#fbf7ef;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 1px rgba(212,179,114,.6),0 18px 40px rgba(195,158,92,.3)">
      <img src="/img/monogram.webp" alt="ELB monogram" width="160" height="160" loading="lazy" style="width:160px;height:auto" />
    </div>
    <div style="flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:16px">
      <h2 id="ab" style="margin:0;font-size:32px;font-weight:600;line-height:1.3"><a href="/about/">เกี่ยวกับบอส</a></h2>
      <p style="margin:0;max-width:36em;font-size:17px;line-height:1.85;font-weight:400">{settings.aboutShortBio}</p>
      <p style="margin:0;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#4a5560">{settings.invitedNote}</p>
    </div>
  </section>
</Base>
