---
// Series listing: /review/, /history/, /drinks/
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SERIES, type SeriesKey } from '../../lib/config';
import { articleUrl, getArticles, getSettings, groupByRestaurant } from '../../lib/content';
import Icon from '../../components/Icon.astro';
import { breadcrumbs } from '../../lib/seo';

export function getStaticPaths() {
  return (Object.keys(SERIES) as SeriesKey[]).map((k) => ({ params: { series: SERIES[k].path }, props: { key: k } }));
}
const { key } = Astro.props as { key: SeriesKey };
const s = SERIES[key];
const all = (await getArticles('th')).filter((a) => a.series === key);
// Reviews: newest visit first (as loaded). Other series read in order: Ep.1 first (the Boss, 13 Nov 2026), with a link to the newest episode.
const list = key === 'review' ? all : [...all].sort((a, b) => (a.episode ?? 0) - (b.episode ?? 0));
const latest = key === 'review' ? undefined : list[list.length - 1];
const groups = groupByRestaurant(list); // repeat visits share one card
const settings = await getSettings();
const intro = settings.seriesText;
const metaDesc = `${intro[key]} อ่านทุกบทความในซีรีส์${s.th}จากบอสพาชิม · Eat Like The Boss รีวิวแบบจริงใจ ไม่ให้ดาว ไม่ให้คะแนน`;
---
<Base title={key === 'review' ? 'รีวิวร้านอาหาร Fine Dining ทั้งหมด' : s.th} description={metaDesc} active="articles" series={key} jsonLd={[breadcrumbs([{ name: 'หน้าแรก', href: '/' }, { name: s.th, href: `/${s.path}/` }])]}>
  <section class="wrap" style="padding-top:88px;padding-bottom:40px;display:flex;flex-direction:column;gap:16px">
    <p class="overline">SERIES</p>
    <h1 class="ink-grad gold-lift" style="margin:0;font-size:clamp(34px,6cqi,52px);font-weight:600;line-height:1.25">{s.th}</h1>
    <p style="margin:0;max-width:34em;font-size:18px;line-height:1.8;font-weight:400">{intro[key]}</p>
    {latest && list.length > 1 && (
      <p style="margin:8px 0 0;display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#3d4955">
        <span>{list.length} ตอน · เรียงจาก Ep.1</span>
        <a href={articleUrl(latest)} class="btn-pill" style={`display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border-radius:var(--r-pill);background:${s.ink};color:#fff`}>อ่านตอนล่าสุด Ep.{latest.episode}<Icon name="arrow" size={16} /></a>
      </p>
    )}
  </section>
  <section class="wrap" style="padding-bottom:96px">
    <div class="rule"></div>
    {list.length ? <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:36px 28px;padding-top:40px">{groups.map((g) => <ArticleCard a={g.latest} visits={g.visits} />)}</div>
      : <p style="padding-top:40px;font-size:18px;font-weight:400">ยังไม่มีบทความในซีรีส์นี้ครับ</p>}
  </section>
</Base>
