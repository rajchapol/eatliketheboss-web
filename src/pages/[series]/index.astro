---
// Series listing: /review/, /history/, /drinks/
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SERIES, type SeriesKey } from '../../lib/config';
import { getArticles } from '../../lib/content';
import { breadcrumbs } from '../../lib/seo';

export function getStaticPaths() {
  return (Object.keys(SERIES) as SeriesKey[]).map((k) => ({ params: { series: SERIES[k].path }, props: { key: k } }));
}
const { key } = Astro.props as { key: SeriesKey };
const s = SERIES[key];
const list = (await getArticles('th')).filter((a) => a.series === key);
const intro: Record<SeriesKey, string> = {
  review: 'รีวิวร้าน Fine Dining ทั้งในไทยและต่างประเทศ เล่าทีละจาน ตั้งแต่จานแรกจนของหวาน',
  history: 'เรื่องเล่าของมื้ออาหารและงานเลี้ยงที่มีผลต่อประวัติศาสตร์',
  drinks: 'ไวน์ สุรา และโรงบ่มที่ผมอยากเล่าต่อ จากมุมของคนในวงการ',
};
---
<Base title={s.th} description={intro[key]} active="articles" jsonLd={[breadcrumbs([{ name: 'หน้าแรก', href: '/' }, { name: s.th, href: `/${s.path}/` }])]}>
  <section class="wrap" style="padding-top:88px;padding-bottom:40px;display:flex;flex-direction:column;gap:16px">
    <p class="overline">SERIES</p>
    <h1 class="ink-grad gold-lift" style="margin:0;font-size:clamp(34px,6cqi,52px);font-weight:600;line-height:1.25">{s.th}</h1>
    <p style="margin:0;max-width:34em;font-size:18px;line-height:1.8;font-weight:300">{intro[key]}</p>
  </section>
  <section class="wrap" style="padding-bottom:96px">
    <div class="rule"></div>
    {list.length ? <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:40px 32px;padding-top:40px">{list.map((a) => <ArticleCard a={a} />)}</div>
      : <p style="padding-top:40px;font-size:18px;font-weight:300">ยังไม่มีบทความในซีรีส์นี้ครับ</p>}
  </section>
</Base>
