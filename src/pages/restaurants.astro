---
import { isRestaurantSeries } from '../lib/config';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, getCities, getSettings, groupByRestaurant } from '../lib/content';
import { AWARDS, CUISINES, REGIONS, regionOf } from '../lib/config';
const st = await getSettings();

const list = (await getArticles('th')).filter((a) => isRestaurantSeries(a.series));
// One card per restaurant; repeat visits are listed inside the card.
const groups = groupByRestaurant(list);
const cityList = (await getCities()).filter((c) => list.some((a) => a.city?.slug === c.slug));
// Cities: the busiest few as quick chips; every city in a list grouped by country (the list keeps working at 50+ cities).
const TOP = 6;
const nIn = (slug: string) => groups.filter((g) => g.latest.city?.slug === slug).length;
const byCount = [...cityList].sort((a, b) => nIn(b.slug) - nIn(a.slug) || a.nameEn.localeCompare(b.nameEn));
const topCities = byCount.slice(0, TOP);
const regionRank = (c: any) => REGIONS.findIndex((r) => r.id === regionOf(c));
const countries = [...new Set([...cityList].sort((a, b) => regionRank(a) - regionRank(b)).map((c) => c.country || 'อื่นๆ'))]
  .map((country) => [country, cityList.filter((c) => (c.country || 'อื่นๆ') === country).sort((a, b) => a.nameEn.localeCompare(b.nameEn))] as const);
const cuisines = ([...new Set(groups.map((g) => g.latest.restaurant?.cuisine).filter(Boolean))] as string[]) // match each card's (latest visit) cuisine
  .sort((x, y) => (CUISINES as readonly string[]).indexOf(x) - (CUISINES as readonly string[]).indexOf(y)); // in the CUISINES order, Other last
// Award filter: awards that some card (latest visit) holds, grouped by guide in the awards.json order
const held = new Set(groups.flatMap((g) => (g.latest.restaurant?.awards ?? []).map((x) => AWARDS.parse(x)?.award).filter(Boolean)));
const awardGroups = Object.entries(AWARDS.groups).map(([guide, list]) => [guide, list.filter((x) => held.has(x))] as const).filter(([, l]) => l.length);
const prices = ['฿฿', '฿฿฿', '฿฿฿฿'];
const chip = "display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;height:44px;padding:0 16px;white-space:nowrap;border:1px solid rgba(11,83,87,.4);background:#fff;color:#1a2632;font-family:'Ekkamai New',sans-serif;font-size:15px";
---
<Base image="/img/og/og-restaurants.jpg" title="ค้นหาร้าน — ร้าน Fine Dining ที่บอสไปชิมแล้ว" description="ค้นหาร้าน Fine Dining ที่บอสไปชิมมาแล้ว จากชื่อร้าน เชฟ เมือง ประเภทอาหาร หรือระดับราคา พร้อมจานถอดแว่นชิม" active="finder">
  <style is:global>
        .card[hidden]{display:none!important}
  </style>
  <section aria-labelledby="ft" style="position:relative;overflow:hidden">
    <div aria-hidden="true" class="pat-loop-light" style="position:absolute;top:0;right:0;bottom:0;width:60%;-webkit-mask-image:linear-gradient(90deg,transparent,#000 75%);mask-image:linear-gradient(90deg,transparent,#000 75%)"></div>
    <div class="wrap" style="position:relative;padding-top:88px;padding-bottom:48px;display:flex;flex-direction:column;gap:20px">
      <p class="overline">RESTAURANT FINDER</p>
      <h1 id="ft" class="ink-grad gold-lift" style="margin:0;font-size:clamp(34px,6cqi,52px);font-weight:600;line-height:1.25">{st.finderTitle}</h1>
      <p style="margin:0;max-width:34em;font-size:18px;line-height:1.8;font-weight:400">{st.finderIntro}</p>
    </div>
  </section>

  <section aria-label="ตัวกรองร้าน" class="wrap">
    <div>
      <form id="filters" class="pat-linen rl" onsubmit="return false" style="background-color:#fbf7ef;padding:clamp(20px,4cqi,32px);display:flex;flex-direction:column;gap:24px;box-shadow:0 0 0 1px rgba(212,179,114,.6),0 24px 48px -16px rgba(11,83,87,.25)">
        <label style="display:flex;flex-direction:column;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#4a5560">ค้นหา
          <span style="position:relative;display:block">
            <Icon name="search" size={22} style="position:absolute;left:18px;top:17px;color:#0b5357" />
            <input id="q" type="search" role="combobox" aria-autocomplete="list" aria-controls="q-sug" aria-expanded="false" autocomplete="off" class="field" placeholder="ชื่อร้าน เชฟ เมือง หรือชื่อจาน" style="width:100%;height:56px;padding:0 18px 0 54px;border:1px solid rgba(11,83,87,.4);border-bottom:2px solid #c39e5c;background:#fff;font-family:'Ekkamai New',sans-serif;font-size:18px;color:#1a2632" />
            <div id="q-sug" class="q-sug" role="listbox" hidden></div>
          </span>
        </label>
        <div style="display:flex;flex-direction:column;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#4a5560">
          <span>เมือง</span>
          <div class="finder-cities">
            <div class="sm-scroll" style="display:flex;flex-wrap:wrap;gap:8px" data-group="city">
              <button type="button" class="chip" data-v="" aria-pressed="true" style={chip}>ทุกเมือง</button>
              {topCities.map((c) => <button type="button" class="chip" data-v={c.slug} aria-pressed="false" style={chip} translate="no"><Icon name="pin" size={16} />{c.nameEn}<span class="chip-n">{nIn(c.slug)}</span></button>)}
            </div>
            {cityList.length > TOP && (
              <label class="city-more">
                <span class="sr-only">เลือกเมือง</span>
                <select id="city-all" class="field" aria-label={`เลือกเมือง (ทั้งหมด ${cityList.length} เมือง)`}>
                  <option value="">เมืองอื่นๆ · ทั้งหมด {cityList.length} เมือง</option>
                  {countries.map(([country, cs]) => <optgroup label={country}>{cs.map((c) => <option value={c.slug} translate="no">{c.nameEn} ({nIn(c.slug)})</option>)}</optgroup>)}
                </select>
              </label>
            )}
          </div>
        </div>
        <button type="button" id="more-toggle" class="more-toggle" aria-expanded="false" aria-controls="more-filters"><Icon name="filter" size={18} />ตัวกรองเพิ่มเติม<span id="more-n" class="chip-n" hidden></span><span class="chev" aria-hidden="true">▾</span></button>
        <div id="more-filters" class="sm-stack more-filters" style="display:flex;flex-wrap:wrap;gap:20px 32px;align-items:flex-end">
          <label class="sm-full" style="display:flex;flex-direction:column;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#4a5560">ประเภทอาหาร
            <select id="cuisine" class="field" style="height:44px;min-width:200px;padding:0 18px;border:1px solid rgba(11,83,87,.4);background:#fff;font-family:'Ekkamai New',sans-serif;font-size:16px;color:#1a2632">
              <option value="">ทั้งหมด</option>{cuisines.map((c) => <option value={c}>{c}</option>)}
            </select>
          </label>
          {awardGroups.length > 0 && (
            <label class="sm-full" style="display:flex;flex-direction:column;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#4a5560">รางวัล
              <select id="award" class="field" translate="no" style="height:44px;min-width:220px;padding:0 18px;border:1px solid rgba(11,83,87,.4);background:#fff;font-family:'Ekkamai New',sans-serif;font-size:16px;color:#1a2632">
                <option value="">ทั้งหมด</option>{awardGroups.map(([guide, l]) => <optgroup label={guide}>{l.map((x) => <option value={x}>{x}</option>)}</optgroup>)}
              </select>
            </label>
          )}
          <div style="display:flex;flex-direction:column;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#4a5560">
            <span>ระดับราคา</span>
            <div style="display:flex;flex-wrap:wrap;gap:8px" data-group="price">
              <button type="button" class="chip" data-v="" aria-pressed="true" style={chip}>ทุกระดับ</button>
              {prices.map((p) => <button type="button" class="chip" data-v={p} aria-pressed="false" style={chip}>{p}</button>)}
            </div>
          </div>
          <button type="button" class="chip" id="glasses" aria-pressed="false" style={chip}><Icon name="glasses" size={18} />เฉพาะร้านที่มีจานถอดแว่นชิม</button>
        </div>
      </form>
    </div>
  </section>

  <section aria-labelledby="rs" class="wrap" style="padding-top:56px;padding-bottom:96px">
    <div class="sm-stack" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px 24px;padding-bottom:16px">
      <h2 id="rs" aria-live="polite" style="margin:0;display:flex;align-items:baseline;gap:12px;font-size:22px;font-weight:400">พบ <span id="count" class="bronze-grad" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:52px;line-height:1">{groups.length}</span> ร้าน</h2>
      <button type="button" id="reset" style="display:inline-flex;align-items:center;gap:6px;min-height:44px;border:0;background:none;padding:0;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357"><span style="border-bottom:1px solid #c39e5c">ล้างตัวกรอง</span></button>
    </div>
    <div class="rule"></div>
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:36px 28px;padding-top:40px">
      {groups.map((g) => <ArticleCard a={g.latest} visits={g.visits} />)}
    </div>
    <p id="empty" hidden style="margin-top:48px;text-align:center;font-size:18px;font-weight:400"><img src="/img/brand/lineart/lineart-menu-card-teal.svg" alt="" width="140" height="140" style="display:block;margin:0 auto 16px;height:auto" />ยังไม่พบร้านที่ตรงกับตัวกรอง ลองล้างตัวกรองหรือค้นด้วยคำอื่นครับ</p>
  </section>

  <script>
    import { matches, norm } from '../lib/search';
    (() => {
      const st = { q: new URLSearchParams(location.search).get('q') || '', city: new URLSearchParams(location.search).get('city') || '', price: '', cuisine: '', award: '', glasses: false };
      const q = document.getElementById('q'), sel = document.getElementById('cuisine'), aw = document.getElementById('award'), g = document.getElementById('glasses');
      const cards = [...document.querySelectorAll('#results .card')];
      const press = (group, v) => document.querySelectorAll(`[data-group="${group}"] .chip`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
      // the city list and the quick chips show the same choice
      const cityAll = document.getElementById('city-all');
      const setCity = (v) => { st.city = v; press('city', v); if (cityAll) cityAll.value = v; };
      // phones: "ตัวกรองเพิ่มเติม" opens the cuisine / award / price / glasses filters; the badge counts the ones in use
      const more = document.getElementById('more-filters'), moreBtn = document.getElementById('more-toggle'), moreN = document.getElementById('more-n');
      moreBtn.addEventListener('click', () => { const open = moreBtn.getAttribute('aria-expanded') !== 'true'; moreBtn.setAttribute('aria-expanded', String(open)); more.classList.toggle('open', open); });
      const run = () => {
        const term = st.q.trim(); let n = 0;
        cards.forEach((c) => {
          const ok = (!st.city || c.dataset.city === st.city) && (!st.price || c.dataset.price === st.price) && (!st.cuisine || c.dataset.cuisine === st.cuisine) && (!st.award || (c.dataset.awards || '').split('|').includes(st.award)) && (!st.glasses || c.dataset.glasses) && (!term || matches(c.dataset.text, term));
          c.hidden = !ok; if (ok) n++;
        });
        document.getElementById('count').textContent = n; document.getElementById('empty').hidden = n > 0;
        const used = [st.cuisine, st.award, st.price, st.glasses].filter(Boolean).length;
        moreN.hidden = !used; moreN.textContent = used;
      };
      // Suggestions under the search box (the Boss, 17 Nov 2026: typing a name "barely showed anything" — the
      // results were below the fold). Up to 6 matches appear right under the box: names that start with the
      // words first, then names that contain them, then the rest (chef, dish, city…). Enter / "ดูทั้งหมด" jumps
      // to the full results.
      const sug = document.getElementById('q-sug'), rs = document.getElementById('rs');
      const info = cards.map((c) => { const a = c.querySelector('h3 a'); return { c, name: a?.textContent?.trim() || '', href: a?.getAttribute('href') || '#', img: c.querySelector('img')?.currentSrc || c.querySelector('img')?.getAttribute('src') || '', place: c.dataset.place || '' }; });
      let active = -1;
      const esc = (t) => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]);
      const closeSug = () => { sug.hidden = true; q.setAttribute('aria-expanded', 'false'); active = -1; };
      const toResults = () => { closeSug(); rs.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); };
      const showSug = () => {
        const term = st.q.trim(); if (!term) return closeSug();
        const t = norm(term);
        const hits = info.filter((x) => !x.c.hidden).map((x) => { const n = norm(x.name); return { x, rank: n.startsWith(t) ? 0 : n.includes(t) ? 1 : 2 }; }).sort((a, b) => a.rank - b.rank);
        const total = hits.length;
        sug.innerHTML = (total ? hits.slice(0, 6).map(({ x }, i) => `<a role="option" id="q-opt-${i}" class="q-opt" href="${esc(x.href)}">${x.img ? `<img src="${esc(x.img)}" alt="" width="56" height="38" loading="lazy" />` : '<span class="q-ph"></span>'}<span class="q-txt"><span class="q-name" translate="no">${esc(x.name)}</span><span class="q-place" translate="no">${esc(x.place)}</span></span></a>`).join('') : '<p class="q-none">ยังไม่พบร้านที่ตรงกับคำค้น ลองสะกดแบบอื่น หรือพิมพ์ชื่อเชฟ ชื่อจาน ชื่อเมือง</p>')
          + (total ? `<button type="button" class="q-all">ดูผลทั้งหมด ${total} ร้าน ↓</button>` : '');
        sug.hidden = false; q.setAttribute('aria-expanded', 'true'); active = -1;
        sug.querySelector('.q-all')?.addEventListener('click', toResults);
      };
      const move = (d) => { const opts = [...sug.querySelectorAll('.q-opt')]; if (!opts.length) return; active = (active + d + opts.length) % opts.length; opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === active))); q.setAttribute('aria-activedescendant', opts[active].id); };
      q.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); if (sug.hidden) showSug(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter') { e.preventDefault(); const opt = sug.querySelectorAll('.q-opt')[active]; if (opt) location.href = opt.getAttribute('href'); else toResults(); }
        else if (e.key === 'Escape') closeSug();
      });
      q.addEventListener('focus', () => { if (st.q.trim()) showSug(); });
      document.addEventListener('click', (e) => { if (!e.target.closest('#q-sug') && e.target !== q) closeSug(); });

      q.value = st.q; setCity(st.city);
      q.addEventListener('input', () => { st.q = q.value; run(); showSug(); });
      sel.addEventListener('change', () => { st.cuisine = sel.value; run(); });
      aw?.addEventListener('change', () => { st.award = aw.value; run(); });
      cityAll?.addEventListener('change', () => { setCity(cityAll.value); run(); });
      g.addEventListener('click', () => { st.glasses = !st.glasses; g.setAttribute('aria-pressed', String(st.glasses)); run(); });
      document.querySelectorAll('[data-group]').forEach((grp) => grp.addEventListener('click', (e) => {
        const b = e.target.closest('.chip'); if (!b) return;
        if (grp.dataset.group === 'city') setCity(b.dataset.v); else { st[grp.dataset.group] = b.dataset.v; press(grp.dataset.group, b.dataset.v); }
        run();
      }));
      document.getElementById('reset').addEventListener('click', () => { Object.assign(st, { q: '', city: '', price: '', cuisine: '', award: '', glasses: false }); q.value = ''; sel.value = ''; if (aw) aw.value = ''; g.setAttribute('aria-pressed', 'false'); setCity(''); press('price', ''); run(); });
      run();
      // came from the home-page search (?q=…): show the results, not the empty top of the page
      if (st.q.trim()) requestAnimationFrame(() => rs.scrollIntoView({ block: 'start' }));
    })();
  </script>
</Base>
