---
// Destinations: Thailand first, then continents; inside each, countries, then city cards.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import CityCover from '../components/CityCover.astro';
import DestinationsMap from '../components/DestinationsMap.astro';
import { MOTIFS, REGIONS, regionOf } from '../lib/config';
import { getCities, getArticles, articleUrl, getSettings, groupByRestaurant, cityPicks, citiesByCount, visitIso } from '../lib/content';
import { romanAt as roman } from '../lib/roman';
const st = await getSettings();

// Only cities that already have a review (all cities while the site is still empty).
const withReviews = await citiesByCount();
const cities = withReviews.length ? withReviews.map((x) => x.city).sort((a, b) => a.nameEn.localeCompare(b.nameEn)) : await getCities();
const articles = (await getArticles('th')).filter((a) => a.series === 'review');
const inCity = (slug: string) => articles.filter((a) => a.city?.slug === slug);
const count = (slug: string) => groupByRestaurant(inCity(slug)).length; // restaurants, not visits
const glasses = (slug: string) => inCity(slug).reduce((n, a) => n + a.dishes.filter((d) => d.glassesOff).length, 0);
// Featured cities: every city ticked "Featured on Destinations" in Studio (up to 3, most restaurants first), else the
// city with the most restaurants. Several = tabs that switch the band.
const ticked = cities.filter((c) => c.featured).sort((x, y) => count(y.slug) - count(x.slug)).slice(0, 3);
const featuredList = (ticked.length ? ticked : [withReviews[0]?.city ?? cities[0]]).filter(Boolean).map((city) => ({
  city, fm: MOTIFS[city.motif] ?? MOTIFS.loop, picks: cityPicks(city, inCity(city.slug)),
}));
const regions = REGIONS.map((r, i) => {
  const list = cities.filter((c) => regionOf(c) === r.id);
  const countries = [...new Set(list.map((c) => c.country || r.name))].map((name) => ({ name, cities: list.filter((c) => (c.country || r.name) === name) }));
  return { ...r, cities: list, countries };
}).filter((r) => r.cities.length).map((r, i) => ({ ...r, num: `${roman(i)}.` }));
const countries = new Set(cities.map((c) => c.country)).size;
const totalRestaurants = groupByRestaurant(articles).length;
// Map: every city with a review, with the month of the first meal there (for the route order).
const mapCities = withReviews.map(({ city, count }) => ({ city, count, firstVisit: inCity(city.slug).map(visitIso).sort()[0] ?? '' }));
---
<Base title="จุดหมาย — ร้าน Fine Dining แยกตามเมือง" description="เลือกเมือง แล้วดูทุกร้าน Fine Dining ที่บอสไปชิม ทั้งกรุงเทพฯ โตเกียว โอซาก้า ฮ่องกง และอีกหลายเมืองทั่วโลก" active="destinations">
  <section aria-labelledby="dt" class="wrap" style="padding-top:80px;padding-bottom:72px;display:flex;flex-direction:column;gap:20px">
    <p class="overline">DESTINATIONS</p>
    <h1 id="dt" class="ink-grad" style="margin:0;font-size:clamp(36px,6.4cqi,56px);font-weight:600;line-height:1.2">{st.destinationsTitle}</h1>
    <p style="margin:0;max-width:32em;font-size:18px;line-height:1.8">{st.destinationsIntro}</p>
    <nav aria-label="ไปที่ภูมิภาค" class="sm-scroll" style="display:flex;flex-wrap:wrap;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:15px">
      {regions.map((g) => <a href={`#${g.id}`} class="chip" style="display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;min-height:44px;padding:0 18px;white-space:nowrap;border:1px solid rgba(11,83,87,.35);background:#fff">{g.name}<span style="font-size:12px;color:#6e3f08">{g.cities.length}</span></a>)}
    </nav>
    <dl style="margin:8px 0 0;display:flex;gap:40px;font-family:'Ekkamai New',sans-serif">
      {[[countries, 'ประเทศ'], [cities.length, 'เมือง'], [totalRestaurants, 'ร้าน']].map(([n, l]) => <div style="display:flex;flex-direction:column-reverse;gap:4px"><dt style="font-size:14px;color:#3d4955">{l}</dt><dd class="bronze-grad" style="margin:0;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:44px;line-height:1" data-count-to={n}>{n}</dd></div>)}
    </dl>
  </section>

  <DestinationsMap cities={mapCities} />

  {featuredList.length > 0 && (
    <section aria-labelledby="fd" class="wrap" data-featured>
      <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 24px;margin-bottom:20px">
        <h2 id="fd" style="margin:0;display:flex;flex-direction:column;gap:6px"><span class="overline">FEATURED {featuredList.length > 1 ? 'CITIES' : 'CITY'}</span><span class="ink-grad" style="font-size:clamp(28px,4.4cqi,38px);font-weight:600;line-height:1.25">เมืองแนะนำของบอส</span></h2>
      </div>
      <ul class={`feat-grid n${featuredList.length}`} role="list">
        {featuredList.map(({ city: featured, fm, picks: fPicks }) => (
          <li class="feat-card band-teal on-dark rl">
            <a href={`/city/${featured.slug}/`} class="feat-photo fx-zoom" aria-label={`ดูร้านใน${featured.nameTh}`}>
              <CityCover city={featured} label={`ภาพเมือง: ${featured.nameEn}`} dark ratio={0.6667} />
              {featured.cover?.url && <span aria-hidden="true" class={`${fm.cls} fade-r`} style="position:absolute;top:0;right:0;bottom:0;width:35%;opacity:.5"></span>}
            </a>
            <div class="feat-body">
              <h3 style="margin:0;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap"><span class="gold-grad" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:clamp(38px,4.4cqi,52px);line-height:1">{featured.nameEn}</span><span style="font-size:19px;font-weight:400;color:#fff">{featured.nameTh}</span></h3>
              <p style="margin:0;display:flex;flex-wrap:wrap;gap:8px;font-family:'Ekkamai New',sans-serif;font-size:14px"><span class="badge" style="background:rgba(255,255,255,.1);color:#fff;font-size:14px"><Icon name="cuisine" size={16} style="color:#d4b372" />{count(featured.slug)} ร้าน</span><span class="badge" style="background:rgba(255,255,255,.1);color:#fff;font-size:14px"><Icon name="glasses" size={16} style="color:#d4b372" />{glasses(featured.slug)} ถอดแว่นชิม</span></p>
              {featured.intro && !featured.intro.startsWith('[') && <p lang="en" class="feat-fact"><span>Did you know?</span>{featured.intro}</p>}
              {fPicks.length > 0 && <ol class="feat-picks">{fPicks.map((a, i) => <li><a href={articleUrl(a)}><span class="n">{roman(i)}.</span><span class="r">{a.restaurant?.name}</span><span class="s">{a.restaurant?.style || a.restaurant?.cuisine}</span></a></li>)}</ol>}
              <a href={`/city/${featured.slug}/`} class="btn-gold fx-btn feat-btn">ดูร้านใน{featured.nameTh} <Icon name="arrow" /></a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <main class="wrap" style="padding-bottom:96px">
    {regions.map((g) => (
      <section id={g.id} aria-labelledby={`h-${g.id}`} style="padding-top:80px;scroll-margin-top:24px">
        <div class="sm-stack" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:8px 24px;padding-bottom:16px">
          <div style="display:flex;align-items:baseline;gap:16px"><span aria-hidden="true" class="bronze-grad" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(44px,7cqi,60px);line-height:.9">{g.num}</span><h2 id={`h-${g.id}`} style="margin:0;font-size:clamp(26px,4cqi,34px);font-weight:600">{g.name}</h2></div>
          <span style="display:flex;align-items:baseline;gap:16px"><span style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;color:#6e3f08">{g.latin}</span><span style="font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955">{g.id === 'th' ? '' : `${g.countries.length} ประเทศ · `}{g.cities.length} เมือง</span></span>
        </div>
        <div class="rule"></div>
        {g.countries.map((country) => (
          <div style="padding-top:32px">
            {g.id !== 'th' && <h3 style="margin:0 0 20px;display:flex;align-items:center;gap:12px;font-size:21px;font-weight:600"><Icon name="pin" size={18} style="color:#c39e5c" />{country.name}<span style="font-family:'Ekkamai New',sans-serif;font-size:13px;font-weight:400;color:#3d4955">{country.cities.length} เมือง</span></h3>}
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:28px">
              {country.cities.map((c) => { const m = MOTIFS[c.motif] ?? MOTIFS.loop; return (
                <a href={`/city/${c.slug}/`} class="fx-lift-light card" style="display:flex;flex-direction:column;background:#fbf7ef;box-shadow:0 0 0 1px rgba(212,179,114,.45),0 14px 32px rgba(195,158,92,.2)">
                  <span style="position:relative;display:block;aspect-ratio:3/2">
                    <span class="fx-zoom" style="position:absolute;inset:0;display:block"><CityCover city={c} label={`ภาพ ${c.nameEn}`} ratio={0.6667} widths={[400, 600]} sizes="300px" /></span>
                    {c.cover?.url && <span aria-hidden="true" class={`${m.cls} fade-r`} style="position:absolute;top:0;right:0;bottom:0;width:45%;opacity:.6"></span>}
                    <span aria-hidden="true" class={m.cls} style="position:absolute;right:16px;bottom:-26px;width:52px;height:52px;border-radius:50%;background-color:#fbf7ef;box-shadow:0 0 0 1px #c39e5c,0 0 0 4px #fbf7ef,0 0 0 5px rgba(212,179,114,.5)"></span>
                  </span>
                  <span style="padding:18px 80px 16px 20px;display:flex;flex-direction:column;gap:8px">
                    <span style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap"><span style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:30px;line-height:1;color:#0b5357">{c.nameEn}</span><span style="font-size:18px;font-weight:600">{c.nameTh}</span></span>
                    <span style="display:flex;flex-wrap:wrap;gap:6px 16px;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#3d4955"><span style="display:inline-flex;gap:6px;align-items:center;white-space:nowrap"><Icon name="cuisine" size={16} style="color:#0b5357" />{count(c.slug)} ร้าน</span><span style="display:inline-flex;gap:6px;align-items:center;white-space:nowrap"><Icon name="glasses" size={16} style="color:#0b5357" />{glasses(c.slug)} ถอดแว่นชิม</span></span>
                  </span>
                  <span class="pat-linen fx-arrow" style="margin-top:auto;padding:12px 20px;border-top:1px solid rgba(195,158,92,.35);display:flex;justify-content:space-between;align-items:center;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#0b5357">ดูร้านในเมืองนี้<Icon name="arrow" style="color:#c39e5c" /></span>
                </a>); })}
            </div>
          </div>
        ))}
      </section>
    ))}
  </main>
</Base>
