---
// Every article in every language and series: /review/tokyo/x/, /history/x/, /en/review/tokyo/x/ …
// Interface text follows the article's language (src/lib/i18n.ts).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LangSwitch from '../components/LangSwitch.astro';
import Photo from '../components/Photo.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ShareBar from '../components/ShareBar.astro';
import { SERIES } from '../lib/config';
import { getAllArticles, articleUrl, translationsOf, imgUrl, visitsOf, restaurantKey, visitIso, visitLabel, capsuleUrl } from '../lib/content';
import { articleLd, breadcrumbs } from '../lib/seo';
import { romanAt as roman } from '../lib/roman';
import { t, formatDate, cuisineText } from '../lib/i18n';
import { getSettings } from '../lib/content';
import type { Article } from '../lib/types';

export async function getStaticPaths() {
  const all = await getAllArticles();
  return all.map((a) => ({ params: { article: articleUrl(a).replace(/^\/|\/$/g, '') }, props: { a } }));
}
const { a } = Astro.props as { a: Article };
const L = a.language;
const st = await getSettings();
const tx = (key: 'menuTitle' | 'glassesQuote', thai: string) => (L === 'th' && thai ? thai : t(L, key)); // Thai text from Studio
const all = await getAllArticles();
const tr = await translationsOf(a);
const alternates = tr.map((x) => ({ lang: x.language, href: articleUrl(x) }));
const visits = visitsOf(a, all); // every review of this restaurant (newest visit first)
const capsule = capsuleUrl(visits); // Thai repeat visits → time capsule page
// More Tasting Notes: same city first, then the same series; other visits of this restaurant are already listed above.
const others = all.filter((x) => x.language === L && x.id !== a.id && restaurantKey(x) !== restaurantKey(a));
const sameCity = (x: Article) => Boolean(a.city && x.city?.slug === a.city.slug);
const more = [...others.filter(sameCity), ...others.filter((x) => !sameCity(x) && x.series === a.series)].slice(0, 3);
const s = SERIES[a.series];
const glassesDishes = a.dishes.map((d, i) => ({ d, i })).filter(({ d }) => d.glassesOff);
const name = a.restaurant?.name ?? a.title;
const glassesIdx = a.dishes.findIndex((d) => d.glassesOff);
const crumbs = [
  { name: t(L, 'home'), href: '/' },
  { name: L === 'th' ? s.th : t(L, 'review'), href: `/${s.path}/` },
  ...(a.city ? [{ name: a.city.nameEn, href: `/city/${a.city.slug}/` }] : []),
  { name, href: articleUrl(a) },
];
const cityName = a.city ? ` ${L === 'th' ? a.city.nameTh : a.city.nameEn}` : '';
const autoDesc = a.series === 'review'
  ? `${a.tagline ? a.tagline + ' — ' : ''}${t(L, 'autoDesc', { name, city: cityName })}`
  : `${a.tagline ? a.tagline + ' — ' : ''}${a.title} — ${SERIES[a.series].th} · Eat Like The Boss`;
const description = a.seoDescription || autoDesc;
const band = a.billBand;
const bill = [band, a.tag].filter(Boolean).join(' · ') || '—'; // The Boss's Bill = price band (+ Event / AD); the real price is never shown
const fact = "margin:0;padding:12px 0;border-bottom:1px solid rgba(195,158,92,.35)";
---
<Base title={a.seoTitle || (a.series === 'review' ? `${name}${a.city ? ` ${a.city.nameEn}` : ''} ${t(L, 'reviewWord')}` : name)} description={description}
  image={`/og/${articleUrl(a).replace(/^\/|\/$/g, '')}.jpg?v=2`} /* bump ?v= when the share-image design changes: LINE and Facebook cache previews by URL */ lang={L} alternates={alternates} type="article" active="articles"
  published={a.publishedAt} modified={a.updatedAt}
  jsonLd={[articleLd(a), breadcrumbs(crumbs)]}>
  <article>
    <div class="wrap" style="padding-top:48px">
      <nav aria-label="breadcrumb" style="margin-bottom:36px"><ol class="crumbs" style="list-style:none;padding:0">
        {crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <><a href={c.href}>{c.name}</a> /</> : <span aria-current="page">{c.name}</span>}</li>)}
      </ol></nav>
      <LangSwitch lang={L} alternates={alternates} />
      <div style="max-width:880px;display:flex;flex-direction:column;gap:20px">
        <p class="overline" style="flex-wrap:wrap">TASTING NOTES <span style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:20px;letter-spacing:0;color:#6e3f08">No. {String(a.no).padStart(3, '0')}</span>
          <span class="badge" style="letter-spacing:.04em;border:1px solid rgba(11,83,87,.5);font-size:13px;font-weight:700;color:#0b5357">{L === 'th' ? s.th : t(L, 'review')}{a.city ? ` in ${a.city.nameEn}` : ''}{a.episode ? ` Ep.${a.episode}` : ''}</span></p>
        <h1 class="ink-grad" translate={a.restaurant?.name ? "no" : undefined} style="margin:0;font-weight:600;font-size:clamp(34px,6cqi,52px);line-height:1.25">{name}{a.restaurant?.originalName && <span style="font-weight:400"> ({a.restaurant.originalName})</span>}</h1>
        {a.tagline && <p style="margin:0;font-size:24px;line-height:1.6"><span class="mark">{a.tagline}</span></p>}
        <p style="margin:0;display:flex;flex-wrap:wrap;gap:8px 20px;font-family:'Ekkamai New',sans-serif;font-size:15px;color:#3d4955">
          <span>{t(L, 'by')} <a href="/about/" rel="author" style="color:#0b5357;border-bottom:1px solid #c39e5c">{t(L, 'boss')}</a></span><span aria-hidden="true">·</span>
          <span>{t(L, 'published')} <time datetime={a.publishedAt}>{formatDate(a.publishedAt, L)}</time></span>
          {a.visit && <><span aria-hidden="true">·</span><span>Visit <time datetime={visitIso(a)}>{a.visit}</time></span></>}<span aria-hidden="true">·</span><span>{t(L, 'readMin', { n: a.readingMinutes })}</span>
        </p>
        {a.series === 'review' && (
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:8px">
            <section aria-label={t(L, 'atGlance')} class="glance rc">
              <p class="glance-head">{t(L, 'atGlance')}</p>
              <dl class="glance-grid">
                <div><dt><Icon name="bill" size={15} />The Boss's Bill</dt><dd class="bill-dd"><span class="band">{band ?? '—'}</span>{a.tag && <span class="tag-pill"><Icon name={a.tag === 'AD' ? 'megaphone' : 'calendar'} size={13} />{a.tag}</span>}</dd></div>
                <div><dt><Icon name="cuisine" size={15} />{t(L, 'cuisine')}</dt><dd>{cuisineText(a.restaurant, L) || '—'}</dd></div>
                {a.restaurant?.awards?.length ? <div><dt><Icon name="award" size={15} />{t(L, 'awards')}</dt><dd>{a.restaurant.awards.join(' · ')}</dd></div> : null}
                {a.city && <div><dt><Icon name="pin" size={15} />{t(L, 'cityArea')}</dt><dd>{a.city.nameEn}{a.restaurant?.area && ` — ${a.restaurant.area}`}</dd></div>}
              </dl>
              {a.dishes.length > 0 && (
                <div class="glance-foot">
                  {glassesDishes.map(({ d, i }) => <a href={`#dish-${i + 1}`} class="glance-gold"><Icon name="glasses" size={16} /><span><b>{t(L, 'glassesOff')}</b> {roman(i)}. {d.name}</span></a>)}
                  <a href="#menu" class="glance-all">{t(L, 'seeCourses', { n: a.dishes.length })}<Icon name="down" size={14} /></a>
                </div>
              )}
            </section>
            <ShareBar path={articleUrl(a)} title={`${name} — Eat Like The Boss`} lang={L} />
          </div>
        )}
        {visits.length > 1 && capsule && (() => {
          const k = visits.findIndex((v) => v.id === a.id); // 0 = latest
          const newer = visits[k - 1], older = visits[k + 1];
          return (
            <nav aria-label={st.capsuleTitle} class="rc capsule-bar" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;padding:12px 18px;background:linear-gradient(120deg,#073b3e 0%,#0b5357 100%);color:#fff;font-family:'Ekkamai New',sans-serif">
              <Icon name="clock" size={18} style="color:#d4b372" />
              <span style="font-size:15px">{t(L, 'visits', { n: visits.length })} · <b style="color:#fdeac0">{k === 0 ? 'ครั้งล่าสุด' : `ครั้งที่ ${visits.length - k}`}</b></span>
              <span style="display:inline-flex;gap:6px;margin-left:auto;flex-wrap:wrap">
                {older && <a href={articleUrl(older)} class="badge" style="border:1px solid rgba(212,179,114,.6);color:#fdeac0;font-size:13px"><Icon name="prev" size={13} />ครั้งก่อน · {visitLabel(older)}</a>}
                {newer && <a href={articleUrl(newer)} class="badge" style="border:1px solid rgba(212,179,114,.6);color:#fdeac0;font-size:13px">ครั้งถัดไป · {visitLabel(newer)}<Icon name="next" size={13} /></a>}
                <a href={capsule} class="badge" style="background:linear-gradient(135deg,#d4b372,#fdeac0);color:#1a2632;font-weight:700;font-size:13px">{st.capsuleLink}<Icon name="arrow" size={13} /></a>
              </span>
            </nav>
          );
        })()}
        {visits.length > 1 && !capsule && (
          <nav aria-label={t(L, 'visits', { n: visits.length })} class="rc" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;padding:14px 18px;background:linear-gradient(120deg,#073b3e 0%,#0b5357 100%);color:#fff;font-family:'Ekkamai New',sans-serif;box-shadow:0 0 0 1px rgba(212,179,114,.5)">
            <Icon name="calendar" size={18} style="color:#d4b372" />
            <strong style="font-size:15px;margin-right:6px">{t(L, 'visits', { n: visits.length })}</strong>
            {visits.map((v) => v.id === a.id
              ? <span class="badge" aria-current="page" style="background:linear-gradient(135deg,#d4b372,#fdeac0);color:#1a2632;font-weight:700;font-size:13px">{t(L, 'thisVisit')} · {visitLabel(v)}</span>
              : <a href={articleUrl(v)} class="badge" style="border:1px solid rgba(212,179,114,.6);color:#fdeac0;font-size:13px">Visit <time datetime={visitIso(v)}>{visitLabel(v)}</time> · No. {String(v.no).padStart(3, '0')}{v.tag ? ` · ${v.tag}` : ''}</a>)}
          </nav>
        )}
      </div>
    </div>

    {a.cover && <div class="wrap" style="padding-top:40px"><div class="rl parallax" style={`aspect-ratio:3/2;max-height:760px;box-shadow:0 0 0 1px rgba(212,179,114,.5),0 30px 60px -20px rgba(11,83,87,.35)`}><Photo img={a.cover} label={t(L, 'coverLabel')} ratio={0.6667} eager sizes="(max-width: 1200px) 100vw, 1140px" widths={[640, 960, 1280, 1920]} /></div></div>}

    <div class="wrap" style="padding-top:64px;display:flex;flex-wrap:wrap;gap:48px 64px;align-items:flex-start">
      <div class="prose" style="flex:999 1 560px;min-width:0" set:html={a.bodyHtml} />
      {a.restaurant && (
        <aside aria-label={t(L, 'restaurantInfo')} class="rc" style="flex:1 1 300px;min-width:0;background:#fbf7ef;padding:8px 24px 20px;box-shadow:0 0 0 1px rgba(212,179,114,.55),0 14px 32px rgba(195,158,92,.22);font-family:'Ekkamai New',sans-serif;font-size:15px">
          <p style="margin:16px 0 4px;font-size:12px;letter-spacing:.24em;color:#0b5357">{t(L, 'atTable')}</p>
          <dl style="margin:0">
            {a.restaurant.chef && <><dt style="padding-top:12px;color:#3d4955">{t(L, 'chef')}</dt><dd style={`${fact};padding-top:2px;font-weight:700`}>{a.restaurant.chef}</dd></>}
            {a.restaurant.awards?.length ? <><dt style="padding-top:12px;color:#3d4955">{t(L, 'awards')}</dt><dd style={`${fact};padding-top:2px;font-weight:700`}>{a.restaurant.awards.join(' · ')}</dd></> : null}
            {a.city && <><dt style="padding-top:12px;color:#3d4955">{t(L, 'cityArea')}</dt><dd style={`${fact};padding-top:2px;font-weight:700`}><a href={`/city/${a.city.slug}/`} style="border-bottom:1px solid #c39e5c">{a.city.nameEn}</a>{a.restaurant.area && ` — ${a.restaurant.area}`}</dd></>}
            <dt style="padding-top:12px;color:#3d4955">The Boss's Bill</dt><dd style={`${fact};padding-top:2px;font-weight:700`}>{bill}</dd>
            {a.visit && <><dt style="padding-top:12px;color:#3d4955">Visit</dt><dd style="margin:0;padding-top:2px;font-weight:700">{a.visit}</dd></>}
          </dl>
        </aside>
      )}
    </div>

    {a.quote && !a.quote.startsWith('[') && (
      <figure class="wrap pull-quote" data-reveal><blockquote>{a.quote}</blockquote><figcaption>— {t(L, 'boss')}</figcaption></figure>
    )}

    {a.gallery && a.gallery.length > 0 && (
      <section aria-label={t(L, 'gallery')} class="wrap" style="padding-top:64px">
        <div class={`gallery g${Math.min(a.gallery.length, 3)}`}>
          {a.gallery.map((g, i) => (
            <figure class="gal-item" data-reveal>
              <div class="rc gal-photo"><Photo img={g} label={g.caption || t(L, 'gallery')} ratio={0.6667} widths={[480, 800, 1200, 1600]} sizes={a.gallery!.length === 1 ? '(max-width: 1200px) 100vw, 1140px' : '(max-width: 720px) 85vw, 560px'} /></div>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {a.dishes.length > 0 && (
      <section aria-labelledby="menu" class="wrap" style="padding-top:88px">
        <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:16px;padding-bottom:16px">
          <h2 id="menu" class="ink-grad" style="margin:0;font-size:clamp(30px,5cqi,40px);font-weight:600;line-height:1.3">{tx('menuTitle', st.articleMenuTitle)}</h2>
          <span style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;color:#6e3f08">{t(L, 'courses', { n: a.dishes.length })}</span>
        </div>
        <div class="rule"></div>
        <nav aria-label={t(L, 'jumpToDish')} class="course-nav" style="position:sticky;top:8px;z-index:5;margin:20px 0 0;padding:8px;display:flex;align-items:center;gap:8px;overflow-x:auto;scrollbar-width:none;border-radius:var(--r-pill);background:rgba(251,247,239,.94);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);box-shadow:0 0 0 1px rgba(212,179,114,.5),0 10px 24px rgba(11,83,87,.12)">
          <span class="course-label" style="flex:0 0 auto;padding:0 6px 0 12px;font-family:'Ekkamai New',sans-serif;font-size:12px;letter-spacing:.2em;color:#0b5357">COURSES</span>
          {a.dishes.map((d, i) => (
            <a href={`#dish-${i + 1}`} class="fx-thumb" style="flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:4px 16px 4px 4px;border-radius:var(--r-pill);background:#fff;box-shadow:0 0 0 1px rgba(212,179,114,.5);font-family:'Ekkamai New',sans-serif;font-size:13px;color:#1a2632;white-space:nowrap;max-width:260px;overflow:hidden;text-overflow:ellipsis">
              <span class={d.glassesOff ? 'thumb thumb-gold' : 'thumb'} style="flex:0 0 36px;width:36px;height:36px;border-radius:50%;background:#e8dfcf;display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px;color:#6e3f08">{roman(i)}.</span><span class="cn-name">{d.glassesOff ? t(L, 'glassesOff') : d.name}</span>
            </a>
          ))}
        </nav>
        {a.dishes.map((d, i) => d.glassesOff ? (
          <article id={`dish-${i + 1}`} aria-label={d.name} class="go-band band-fan on-dark spot" style="margin:56px 0;padding:48px;border-radius:var(--r-lg);color:#fff;box-shadow:0 0 0 1px rgba(212,179,114,.55),0 24px 56px rgba(0,0,0,.25)">
            <div class="dish-row">
              {d.image?.url && (
              <figure style="flex:7 1 480px;min-width:0;margin:0;position:relative">
                <div class="dish-photo-dark" style="aspect-ratio:3/2;background:#073b3e"><Photo img={d.image} label={t(L, 'dishPhoto', { n: roman(i) })} ratio={0.6667} dark sizes="(max-width: 720px) 100vw, 680px" widths={[480, 800, 1200, 1600]} /></div>
                <span class="badge badge-dark fx-pulse" style="position:absolute;left:14px;top:14px;padding:8px 14px;font-size:13px;letter-spacing:.12em"><Icon name="glasses" size={16} />GLASSES OFF</span>
              </figure>
              )}
              <div style={`flex:5 1 320px;min-width:0;display:flex;flex-direction:column;gap:16px${d.image?.url ? '' : ';max-width:760px;margin:0 auto'}`}>
                <span class="gold-grad" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:64px;line-height:.9">{roman(i)}.</span>
                <h3 style="margin:0;font-size:clamp(24px,3.6cqi,30px);font-weight:600;line-height:1.4;color:#fff">{d.name}</h3>
                <p style="margin:0;font-size:clamp(19px,2.6cqi,22px);line-height:1.6;color:#fdeac0">{tx('glassesQuote', st.articleGlassesQuote)}</p>
                <span aria-hidden="true" style="width:64px;height:2px;border-radius:2px;background:linear-gradient(90deg,#c39e5c,#fdeac0)"></span>
                <p class="dish-desc" style="margin:0;font-size:17px;line-height:1.9;font-weight:400;color:#fff">{d.description}</p>
              </div>
            </div>
          </article>
        ) : (
          <article id={`dish-${i + 1}`} aria-label={d.name} class="dish-pad" style="padding:64px 0;border-bottom:1px solid rgba(195,158,92,.35)">
            <div class={i % 2 && d.image?.url ? 'dish-row flip' : 'dish-row'}>
              {/* No photo for this dish: text only (no "[ภาพจาน]" placeholder on the live site). */}
              {d.image?.url && (
              <figure class="dish-fig" style="flex:7 1 480px;min-width:0">
                <div class="dish-photo" style="aspect-ratio:3/2;background:#e8dfcf"><Photo img={d.image} label={t(L, 'dishPhoto', { n: roman(i) })} ratio={0.6667} sizes="(max-width: 720px) 100vw, 680px" widths={[480, 800, 1200, 1600]} /></div>
              </figure>
              )}
              <div style={`flex:5 1 320px;min-width:0;display:flex;flex-direction:column;gap:14px${d.image?.url ? '' : ';max-width:760px;margin:0 auto'}`}>
                <span style="display:flex;align-items:center;gap:16px"><span class="bronze-grad" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:56px;line-height:.9">{roman(i)}.</span><span aria-hidden="true" style="flex:1;height:1px;background:linear-gradient(90deg,#c39e5c,rgba(195,158,92,0))"></span></span>
                <h3 style="margin:0;font-size:clamp(22px,3.2cqi,27px);font-weight:600;line-height:1.45">{d.name}</h3>
                <p class="dish-desc" style="margin:0;font-size:17px;line-height:1.9;font-weight:400;color:#25313d">{d.description}</p>
              </div>
            </div>
          </article>
        ))}
      </section>
    )}

    <section aria-label={t(L, 'summary')} class="rc" style="max-width:720px;margin:88px auto 0;padding:28px 32px;display:flex;flex-direction:column;gap:14px;font-family:'Ekkamai New',sans-serif;background:#fbf7ef;box-shadow:0 0 0 1px rgba(212,179,114,.5)">
      {a.visit && <div style="display:flex;align-items:baseline;gap:12px;font-size:18px"><span>Visit</span><span aria-hidden="true" style="flex:1;border-bottom:1px dotted #926633"></span><strong>{a.visit}</strong></div>}
      {a.series === 'review' && <div style="display:flex;align-items:baseline;gap:12px;font-size:18px"><span>The Boss's Bill</span><span aria-hidden="true" style="flex:1;border-bottom:1px dotted #926633"></span><strong>{bill}</strong></div>}
      {a.hashtags.length > 0 && <p style="margin:12px 0 0;display:flex;flex-wrap:wrap;gap:8px;font-size:14px">{a.hashtags.map((h) => <span class="badge" style="font-size:13px;border:1px solid rgba(11,83,87,.35);color:#0b5357">#{h}</span>)}</p>}
    </section>
    <div style="max-width:720px;margin:28px auto 0;padding:0 32px"><ShareBar path={articleUrl(a)} title={`${name} — Eat Like The Boss`} lang={L} heading={L === 'th' ? st.articleShareTitle : true} /></div>
  </article>

  {more.length > 0 && (
    <section aria-labelledby="more" class="wrap" style="padding-top:96px;padding-bottom:96px">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px 24px;margin:0 0 16px">
        <h2 id="more" class="ink-grad" style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-style:italic;font-size:44px;line-height:1.1">{t(L, 'more')}</h2>
        {a.city && L === 'th' && more.some(sameCity) && <a href={`/city/${a.city.slug}/`} class="fx-under" style="font-family:'Ekkamai New',sans-serif;font-size:15px;color:#0b5357;display:inline-flex;align-items:center;gap:8px">ดูทุกร้านใน{a.city.nameTh}<Icon name="arrow" size={16} style="color:#c39e5c" /></a>}
      </div>
      <div class="rule"></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:36px 28px;padding-top:40px">{more.map((m) => <ArticleCard a={m} visits={visitsOf(m, all)} />)}</div>
    </section>
  )}
  {more.length === 0 && <div style="height:96px"></div>}

  <script>
    // Thin gold reading-progress line at the top of the screen.
    (() => { const bar = document.querySelector('[data-progress]'), art = document.querySelector('article'); if (!bar || !art) return;
      let raf = 0; const upd = () => { raf = 0; const r = art.getBoundingClientRect(); const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight))); bar.style.transform = `scaleX(${p})`; };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(upd); }, { passive: true }); upd(); })();
  </script>
</Base>
