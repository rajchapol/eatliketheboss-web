---
import Base from '../layouts/Base.astro';
---
<Base title="ไม่พบหน้านี้" noindex>
  <section class="wrap" style="padding-top:120px;padding-bottom:120px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
    <img src="/img/brand/error-404.svg" alt="" width="320" height="200" style="max-width:80vw;height:auto" />
    <h1 style="margin:0;font-size:32px;font-weight:600">ไม่พบหน้านี้ครับ</h1>
    <p style="margin:0;font-size:18px;font-weight:400">หน้านี้อาจถูกย้ายไปแล้ว ลองค้นหาร้านหรือกลับไปหน้าแรกได้เลยครับ</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center"><a href="/restaurants/" class="btn-teal">ค้นหาร้าน</a><a href="/" class="btn-gold">หน้าแรก</a></div>
  </section>
</Base>
