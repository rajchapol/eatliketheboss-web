---
// Full-screen photo viewer for an article (the Boss, 10 Nov 2026): tap any article photo (img[data-full]) to see the
// whole photo uncropped; swipe or ← → between photos, pinch to zoom (browser), Esc / ✕ / tap outside to close.
// Copy protection stays: no right-click / drag / long-press save (same rules as Effects.astro).
import { t } from '../lib/i18n';
import type { Locale } from '../lib/config';
interface Props { lang?: Locale }
const { lang = 'th' } = Astro.props;
const labels = { close: t(lang, 'lbClose'), prev: t(lang, 'lbPrev'), next: t(lang, 'lbNext'), title: t(lang, 'lbTitle') };
---
<dialog class="lb" aria-label={labels.title} data-labels={JSON.stringify(labels)}>
  <div class="lb-track" tabindex="-1"></div>
  <p class="lb-cap" aria-live="polite"></p>
  <button type="button" class="lb-btn lb-close" aria-label={labels.close}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg></button>
  <button type="button" class="lb-btn lb-prev" aria-label={labels.prev}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></button>
  <button type="button" class="lb-btn lb-next" aria-label={labels.next}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></button>
</dialog>

<style is:global>
  .lb{position:fixed;inset:0;width:100vw;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:rgba(7,22,24,.96);color:#fdeac0}
  .lb::backdrop{background:transparent}
  .lb[open]{display:block}
  .lb-track{height:100%;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;outline:none}
  .lb-track::-webkit-scrollbar{display:none}
  .lb-slide{flex:0 0 100%;height:100%;display:flex;align-items:center;justify-content:center;scroll-snap-align:center;padding:56px 12px 64px;box-sizing:border-box}
  .lb-slide img{max-width:100%;max-height:100%;object-fit:contain;border-radius:6px;-webkit-touch-callout:none;user-select:none;touch-action:pinch-zoom pan-x}
  .lb-cap{position:absolute;left:0;right:0;bottom:16px;margin:0;padding:0 72px;text-align:center;font-family:'Ekkamai New',sans-serif;font-size:14px;line-height:1.5;color:#fdeac0}
  .lb-btn{position:absolute;display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:999px;background:rgba(253,234,192,.12);color:#fdeac0;cursor:pointer}
  .lb-btn:hover,.lb-btn:focus-visible{background:rgba(253,234,192,.24)}
  .lb-btn:focus-visible{outline:2px solid #c39e5c;outline-offset:2px}
  .lb-close{top:max(12px,env(safe-area-inset-top));right:12px}
  .lb-prev{left:12px;top:50%;transform:translateY(-50%)}
  .lb-next{right:12px;top:50%;transform:translateY(-50%)}
  @media (hover:none){.lb-prev,.lb-next{display:none}} /* phones: swipe */
  html.lb-open{overflow:hidden}
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lb');
  if (dlg && typeof dlg.showModal === 'function') {
    const track = dlg.querySelector<HTMLElement>('.lb-track')!;
    const cap = dlg.querySelector<HTMLElement>('.lb-cap')!;
    let photos: HTMLImageElement[] = [];
    let opener: HTMLElement | null = null;

    const build = () => {
      photos = [...document.querySelectorAll<HTMLImageElement>('main img[data-full], img[data-full]')].filter((v, i, a) => a.indexOf(v) === i);
      track.replaceChildren(...photos.map((p) => {
        const s = document.createElement('div'); s.className = 'lb-slide';
        const im = document.createElement('img'); im.alt = p.alt; im.decoding = 'async'; im.loading = 'lazy'; im.dataset.src = p.dataset.full!;
        s.append(im); return s;
      }));
    };
    const at = () => Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
    const load = (i: number) => [i - 1, i, i + 1].forEach((k) => { const im = track.children[k]?.querySelector('img'); if (im && !im.src) im.src = im.dataset.src!; });
    const show = (i: number, smooth = false) => {
      i = Math.max(0, Math.min(photos.length - 1, i)); load(i);
      track.scrollTo({ left: i * track.clientWidth, behavior: smooth ? 'smooth' : 'instant' as ScrollBehavior });
      cap.textContent = photos[i]?.alt || '';
    };
    const open = (img: HTMLImageElement) => {
      if (!photos.length) build();
      opener = img; document.documentElement.classList.add('lb-open'); dlg.showModal();
      requestAnimationFrame(() => show(photos.indexOf(img)));
    };
    const close = () => { dlg.close(); };
    dlg.addEventListener('close', () => { document.documentElement.classList.remove('lb-open'); opener?.focus({ preventScroll: true }); });

    document.addEventListener('click', (e) => {
      const img = (e.target as HTMLElement).closest?.('img[data-full]') as HTMLImageElement | null;
      if (img && !dlg.contains(img)) { e.preventDefault(); open(img); }
    });
    document.addEventListener('keydown', (e) => {
      const el = document.activeElement as HTMLElement | null;
      if (!dlg.open && el?.matches?.('img[data-full]') && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(el as HTMLImageElement); return; }
      if (!dlg.open) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at() + 1, true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at() - 1, true); }
    });
    let t: number | undefined;
    track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(() => { load(at()); cap.textContent = photos[at()]?.alt || ''; }, 80); }, { passive: true });
    dlg.querySelector('.lb-close')!.addEventListener('click', close);
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(at() - 1, true));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(at() + 1, true));
    // tap on the dark area (not the photo, not a button) closes
    track.addEventListener('click', (e) => { if ((e.target as HTMLElement).classList.contains('lb-slide')) close(); });
    dlg.addEventListener('contextmenu', (e) => e.preventDefault());
    dlg.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>
