---
// Article card used in every grid. Pass `visits` (all reviews of the same restaurant, newest first)
// to show "รีวิว N ครั้ง" and a link to each visit.
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { AWARDS, SERIES } from '../lib/config';
import { articleUrl, visitIso, visitLabel, capsuleUrl, getSettings } from '../lib/content';
import { searchText } from '../lib/search';
import type { Article } from '../lib/types';
import { t, cuisineText } from '../lib/i18n';
interface Props { a: Article; visits?: Article[] }
const { a, visits = [a] } = Astro.props;
const all = visits.length ? visits : [a];
const glasses = all.some((v) => v.dishes.some((d) => d.glassesOff));
const s = SERIES[a.series];
const repeat = all.length > 1;
const L = a.language; // cards on translated pages speak that language
const seriesName = t(L, a.series === 'history' ? 'seriesHistory' : a.series === 'drinks' ? 'seriesDrinks' : 'seriesReview');
const st = await getSettings();
const y0 = visitIso(all[all.length - 1]).slice(0, 4), y1 = visitIso(all[0]).slice(0, 4);
// Finder search text: names, chef, city and every dish name from every visit.
// Prepared by src/lib/search.ts: Thai/English synonyms added, tone marks and spaces removed.
const text = searchText(all.flatMap((v) => [v.title, v.tagline, v.restaurant?.name, v.restaurant?.originalName, v.restaurant?.chef, v.restaurant?.area, v.restaurant?.cuisine, v.restaurant?.style,
  ...(v.restaurant?.awards ?? []), ...(v.restaurant?.aliases ?? []), v.city?.nameEn, v.city?.nameTh, v.city?.country, ...(v.city?.aliases ?? []), ...v.dishes.map((d) => d.name), ...v.hashtags]));
---
<article class="card fx-lift-light" data-city={a.city?.slug ?? ''} data-cuisine={a.restaurant?.cuisine ?? ''} data-awards={(a.restaurant?.awards ?? []).map((x) => AWARDS.parse(x)?.award).filter(Boolean).join('|')}
  data-price={a.billBand ?? ''} data-glasses={glasses ? '1' : ''} data-text={text}
  style="display:flex;flex-direction:column;background:#fbf7ef;box-shadow:0 0 0 1px rgba(212,179,114,.45),0 14px 32px rgba(195,158,92,.2)">
  <span style="position:relative;display:block;aspect-ratio:3/2">
    <span class="fx-zoom" style="position:absolute;inset:0;display:block"><Photo img={a.cover} label="ภาพปก" ratio={0.6667} widths={[400, 600, 900]} sizes="(max-width: 720px) 100vw, 360px" /></span>
    <span style="position:absolute;left:12px;top:12px;right:12px;display:flex;flex-wrap:wrap;gap:6px;align-items:flex-start">
      <span class="badge badge-light"><span aria-hidden="true" style={`width:8px;height:8px;border-radius:50%;background:${s.dot}`}></span>{seriesName}</span>
      {a.tag && <span class="badge badge-light" style="color:#6e3f08;font-weight:700"><Icon name={a.tag.startsWith('AD') ? 'megaphone' : 'calendar'} size={13} />{a.tag}</span>}
      {glasses && <span class="badge badge-dark go-badge" style="margin-left:auto"><img src="/img/brand/go-mark.svg" alt="" width="20" height="20" />{t(L, 'glassesOff')}</span>}
    </span>
    <span style="position:absolute;left:0;right:0;bottom:0;padding:36px 16px 10px;background:linear-gradient(180deg,rgba(7,59,62,0) 0%,rgba(7,59,62,.82) 100%);display:flex;justify-content:space-between;align-items:baseline;gap:12px">
      <span style="font-family:'Ekkamai New',sans-serif;font-size:12px;letter-spacing:.18em;color:#fdeac0">{repeat ? t(L, 'reviewedTimes', { n: all.length }) : 'TASTING NOTES'}</span>
      <span style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;line-height:1;color:#fdeac0">No. {String(a.no).padStart(3, '0')}</span>
    </span>
  </span>
  <span style="padding:18px 20px 16px;display:flex;flex-direction:column;gap:8px">
    {a.city && <span style="display:flex;align-items:center;gap:6px;font-family:'Ekkamai New',sans-serif;font-size:12px;letter-spacing:.14em;color:#0b5357"><Icon name="pin" size={15} style="color:#c39e5c" />{a.city.nameEn.toUpperCase()}<span style="letter-spacing:0;color:#3d4955">· Visit <time datetime={visitIso(a)}>{visitLabel(a)}</time></span></span>}
    <h3 style="margin:0;font-size:20px;font-weight:600;line-height:1.4"><a href={articleUrl(a)} class="card-link" translate={a.restaurant?.name ? "no" : undefined}>{a.restaurant?.name ?? a.title}</a></h3>
    {a.restaurant && (
      <span style="display:flex;flex-wrap:wrap;gap:6px 16px;font-family:'Ekkamai New',sans-serif;font-size:13px;color:#3d4955">
        {a.restaurant.cuisine && <span style="display:inline-flex;align-items:center;gap:6px"><Icon name="cuisine" size={16} style="color:#0b5357" />{cuisineText(a.restaurant, L)}</span>}
        {a.restaurant.awards?.length ? <span style="display:inline-flex;align-items:center;gap:6px"><Icon name="award" size={16} style="color:#0b5357" />{a.restaurant.awards.join(', ')}</span> : null}
        {a.billBand && <span class="band-pill" title="The Boss's Bill (ระดับราคาโดยประมาณ)"><Icon name="bill" size={13} />{a.billBand}</span>}
      </span>
    )}
  </span>
  {repeat ? (
    <a href={capsuleUrl(all) ?? articleUrl(all[0])} class="over pat-linen fx-arrow capsule-link" style="margin-top:auto;padding:14px 20px;border-top:1px solid rgba(195,158,92,.35);justify-content:space-between;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#0b5357">
      <span style="display:inline-flex;align-items:center;gap:8px"><Icon name="clock" size={16} style="color:#c39e5c" />{st.capsuleTitle} · ไป {all.length} ครั้ง · {y0 === y1 ? y1 : `${y0}–${y1}`}</span><Icon name="arrow" size={16} />
    </a>
  ) : (
    <span class="pat-linen fx-arrow" aria-hidden="true" style="margin-top:auto;padding:14px 20px;border-top:1px solid rgba(195,158,92,.35);display:flex;justify-content:space-between;align-items:center;font-family:'Ekkamai New',sans-serif;font-size:14px;color:#0b5357">{t(L, 'readNotes')}<Icon name="arrow" style="color:#c39e5c" /></span>
  )}
</article>
