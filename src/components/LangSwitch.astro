---
// "Read in: ไทย · English" — shown at the top of an article that exists in more than one language.
// Only articles are translated, so the switcher lives with the article, not in the site header.
// No machine translation (Google Translate broke the site twice): only real translations appear.
import Icon from './Icon.astro';
import { LOCALES, HREFLANG, type Locale } from '../lib/config';
interface Props { lang: Locale; alternates: { lang: Locale; href: string }[] }
const { lang, alternates } = Astro.props;
const NAME: Record<Locale, string> = { th: 'ไทย', en: 'English', ja: '日本語', zh: '中文' };
const LABEL: Record<Locale, string> = { th: 'อ่านภาษา', en: 'Read in', ja: '言語', zh: '语言' };
const altFor = (l: Locale) => alternates.find((a) => a.lang === l)?.href;
const available = LOCALES.filter((l) => l === lang || altFor(l));
---
{available.length > 1 && (
  <div role="group" aria-label={LABEL[lang]} translate="no" class="lang-switch">
    <span class="ls-label"><Icon name="globe" size={16} />{LABEL[lang]}</span>
    {available.map((l) => l === lang
      ? <span class="ls-opt" aria-current="true" lang={HREFLANG[l]}>{NAME[l]}</span>
      : <a class="ls-opt" href={altFor(l)} lang={HREFLANG[l]} hreflang={HREFLANG[l]}>{NAME[l]}</a>)}
  </div>
)}
