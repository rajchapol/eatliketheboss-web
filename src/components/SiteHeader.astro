---
import Icon from './Icon.astro';
import { LOCALES, LOCALE_LABEL, HREFLANG, SITE, type Locale } from '../lib/config';
import { NAV_LABELS, NAV_ITEMS } from '../lib/i18n';
interface Props { active?: 'finder' | 'destinations' | 'articles' | 'awards' | 'about' | 'home'; lang: Locale; alternates: { lang: Locale; href: string }[] }
const { active = 'home', lang, alternates } = Astro.props;
const N = NAV_LABELS[lang];
const altFor = (l: Locale) => alternates.find((a) => a.lang === l)?.href;
// A real translation (posts/<slug>.<lang>.md or Studio) opens in place. A language with no translation yet
// opens Google Translate in a NEW TAB, so this site itself is never wrapped by Google's proxy (doing that in
// the same tab broke going back to Thai, links and images). Translations take over as soon as they exist.
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const GT_LANG: Record<Locale, string> = { th: 'th', en: 'en', ja: 'ja', zh: 'zh-CN' };
const googleHref = (l: Locale) => `https://translate.google.com/translate?sl=${GT_LANG[lang]}&tl=${GT_LANG[l]}&hl=${GT_LANG[l]}&u=${encodeURIComponent(pageUrl)}`;
const autoTitle = lang === 'th' ? 'แปลอัตโนมัติด้วย Google (เปิดแท็บใหม่)' : 'Machine translation by Google (opens a new tab)';
---
<header class="site-header" style="color:#fff;font-family:'Ekkamai New',sans-serif;box-shadow:0 10px 28px rgba(195,158,92,.28)">
  <div class="wrap hdr" style="padding-top:20px;padding-bottom:20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 28px">
    <a href="/" class="logo" aria-label={lang === "th" ? "Eat Like The Boss — หน้าแรก" : "Eat Like The Boss — Home"}><img src="/img/logo-gold.webp" alt="Eat Like The Boss" width="200" height="179" class="gold-glow" style="display:block;width:200px;height:auto" /></a>
    <nav aria-label={lang === "th" ? "เมนูหลัก" : "Main menu"} class="main-nav">
      {NAV_ITEMS.map(([key, href, icon]) => (
        <a href={href} aria-current={key === active ? 'page' : undefined}>
          <Icon name={icon} size={18} class="nav-ico" />
          {key === 'awards' ? <span><span class="nav-long">Glasses Off </span>Awards</span> : <span>{N[key]}</span>}
        </a>))}
    </nav>
    <div role="group" aria-label="เลือกภาษา / Language" translate="no" class="lang" style="display:flex;align-items:center;font-size:13px">
      <Icon name="globe" size={18} style="margin-right:4px;color:#d4b372" />
      {LOCALES.map((l) => {
        const href = altFor(l);
        if (l === lang) return <a href={href ?? pageUrl} lang={HREFLANG[l]} aria-current="true"><span>{LOCALE_LABEL[l]}</span></a>;
        if (href) return <a href={href} lang={HREFLANG[l]} hreflang={HREFLANG[l]}><span>{LOCALE_LABEL[l]}</span></a>;
        return <a href={googleHref(l)} class="auto" target="_blank" rel="nofollow noopener" lang={HREFLANG[l]} title={autoTitle} aria-label={`${LOCALE_LABEL[l]} — ${autoTitle}`}><span>{LOCALE_LABEL[l]}<Icon name="external" size={11} /></span></a>;
      })}
    </div>
  </div>
  <div class="goldrule"></div>
</header>
